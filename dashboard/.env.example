# Website/API: SELECT-only AWS RDS connection. Keep credentials server-side.
STATARENA_DATA_PROVIDER=aws
DATABASE_URL=
DATABASE_POOL_MAX=1
# Optional PEM override; the verified Ohio RDS CA is bundled by default.
DATABASE_CA_PEM=
# Public read API origin, set before the Next production build.
NEXT_PUBLIC_API_ORIGIN=https://d317dq37z1tacb.cloudfront.net
# Existing binary-image CDN; structured football data is served from RDS tables.
STATARENA_CLOUDFRONT_URL=https://d2clu0phovomb8.cloudfront.net
# Local development transport (the browser uses the configured API origin in production).
ORION_API_ORIGIN=http://127.0.0.1:8765
ORION_EMBEDDED_API=1
# Sample origin SQL/cache timing; 0 disables, 1 samples every request.
STATARENA_METRICS_SAMPLE_RATE=0.01
STATARENA_SERVER_TIMING=0
# Source collection credentials belong only to the GitHub ingestion jobs.
# The AWS shared action obtains writer credentials from SSM via scoped OIDC.
# Runtime credentials are used only by the AWS backend; the Vercel frontend needs only the public API origin.
