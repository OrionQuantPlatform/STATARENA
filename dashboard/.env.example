# Runtime: pooled read-only Neon SQL and private read-only object storage.
NEON_DATABASE_URL=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=statarena-data
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# For AWS, keep the legacy variable names above but point them to RDS and S3.
# STATARENA_EXTERNAL_STORAGE=1
# STATARENA_SQL_DOCUMENTS=1
# STATARENA_CLOUDFRONT_URL=https://your-distribution.cloudfront.net
# STATARENA_DATABASE_CA_PEM=<RDS regional CA bundle, PEM encoded>
# STATARENA_S3_PATH_STYLE=0
# STATARENA_SQL_LIMIT_BYTES=18000000000
# STATARENA_OBJECT_LIMIT_BYTES=<optional limit for stored object bytes>
# Local Next -> Bun transport (unused on Vercel).
ORION_API_ORIGIN=http://127.0.0.1:8765
# Origin-only structured metrics: sample 1% by default; 0 disables, 1 samples all.
STATARENA_METRICS_SAMPLE_RATE=0.01
# Optional origin timing header for diagnostics; never a CDN HIT measurement.
STATARENA_SERVER_TIMING=0
# Pitch credentials belong only in GitHub Actions ingestion secrets.
