# Runtime: pooled read-only Neon SQL and private read-only object storage.
NEON_DATABASE_URL=
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=statarena-data
NEON_STORAGE_REGION=us-east-2
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
# Optional filesystem deployment: FILE_STORAGE_ROOT contains data/raw,
# data/computed and data/sources. The SQL URL must point to its local database.
# FILE_STORAGE_ROOT=/srv/statarena
# STATARENA_DATABASE_SSLMODE=disable
# STATARENA_SQL_LIMIT_BYTES=0
# STATARENA_OBJECT_LIMIT_BYTES=0
# Local Next -> Bun transport (unused on Vercel).
ORION_API_ORIGIN=http://127.0.0.1:8765
# Pitch credentials belong only in GitHub Actions ingestion secrets.
