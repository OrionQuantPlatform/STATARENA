	        LEFT JOIN statarena_app.compact_half_members m ON m.template=g.template AND m.position=c.position
	        WHERE m.definition IS NULL OR (m.definition,m.record_delta,m.in_wide)
	        IS DISTINCT FROM (c.definition,c.record_delta,c.in_wide)
	    ) THEN RAISE EXCEPTION 'Unverified compact half metric template'; END IF;
	
	    INSERT INTO statarena_app.compact_half_groups(resource_id,parent_no,template,base_no,accurate_crosses,accurate_crosses_total,accurate_passes,accurate_passes_total,aerials_won,aerials_won_total,assists,clearances,dispossessed,dribbles_succeeded,dribbles_succeeded_total,duel_lost,duel_won,expected_goals,fouls,goals,ground_duels_won,ground_duels_won_total,interceptions,long_balls_accurate,long_balls_accurate_total,matchstats_headers_tackles,minutes_played,recoveries,saves,total_shots,touches,touches_opp_box,was_fouled)
	    SELECT c.resource_id,c.parent_no,g.template,c.base_no,
	        max(c.v) FILTER (WHERE c.slot=1 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=1 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=2 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=2 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=3 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=3 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=4 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=5 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=6 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=7 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=7 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=8 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=9 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=10 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=11 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=12 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=13 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=13 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=14 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=15 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=15 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=16 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=17 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=18 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=19 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=20 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=21 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=22 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=23 AND c.in_wide AND NOT c.overflow)
	    FROM pg_temp.statarena_metric_cells c JOIN pg_temp.statarena_metric_groups g USING(resource_id,parent_no)
	    GROUP BY c.resource_id,c.parent_no,g.template,c.base_no;
	    INSERT INTO statarena_app.compact_half_overflow(resource_id,parent_no,position,v,t)
	    SELECT resource_id,parent_no,position,v,t FROM pg_temp.statarena_metric_cells WHERE overflow;
	END
	$function$;
	
	CREATE OR REPLACE VIEW statarena_app.compact_half_rows AS
	SELECT w.resource_id,w.base_no+m.record_delta AS record_no,array_remove(ARRAY[CASE WHEN (d.flags & 1)<>0 THEN 'key' END,CASE WHEN (d.flags & 2)<>0 THEN 'stat' END,CASE WHEN (d.flags & 4)<>0 THEN 'stat.type' END,CASE WHEN (d.flags & 8)<>0 THEN 'stat.value' END,CASE WHEN (d.flags & 16)<>0 THEN 'stat.total' END],NULL) AS missing,
	       CASE WHEN (d.flags & 32)<>0 THEN ARRAY['stat'] ELSE ARRAY[]::text[] END AS null_groups,
	       w.parent_no,m.position,d.label AS metric_label,d.source_key AS key,d.value_type AS stat_type,
	       CASE WHEN x.position IS NOT NULL THEN x.v ELSE CASE d.slot WHEN 1 THEN w.accurate_crosses::float8 WHEN 2 THEN w.accurate_passes::float8 WHEN 3 THEN w.aerials_won::float8 WHEN 4 THEN w.assists::float8 WHEN 5 THEN w.clearances::float8 WHEN 6 THEN w.dispossessed::float8 WHEN 7 THEN w.dribbles_succeeded::float8 WHEN 8 THEN w.duel_lost::float8 WHEN 9 THEN w.duel_won::float8 WHEN 10 THEN w.expected_goals::float8 WHEN 11 THEN w.fouls::float8 WHEN 12 THEN w.goals::float8 WHEN 13 THEN w.ground_duels_won::float8 WHEN 14 THEN w.interceptions::float8 WHEN 15 THEN w.long_balls_accurate::float8 WHEN 16 THEN w.matchstats_headers_tackles::float8 WHEN 17 THEN w.minutes_played::float8 WHEN 18 THEN w.recoveries::float8 WHEN 19 THEN w.saves::float8 WHEN 20 THEN w.total_shots::float8 WHEN 21 THEN w.touches::float8 WHEN 22 THEN w.touches_opp_box::float8 WHEN 23 THEN w.was_fouled::float8 END END AS stat_value, CASE WHEN x.position IS NOT NULL THEN x.t ELSE CASE d.slot WHEN 1 THEN w.accurate_crosses_total::float8 WHEN 2 THEN w.accurate_passes_total::float8 WHEN 3 THEN w.aerials_won_total::float8 WHEN 7 THEN w.dribbles_succeeded_total::float8 WHEN 13 THEN w.ground_duels_won_total::float8 WHEN 15 THEN w.long_balls_accurate_total::float8 END END AS stat_total
	FROM statarena_app.compact_half_groups w JOIN statarena_app.compact_half_members m ON m.template=w.template
	JOIN statarena_app.compact_half_definitions d ON d.id=m.definition
	LEFT JOIN statarena_app.compact_half_overflow x ON (x.resource_id,x.parent_no,x.position)=(w.resource_id,w.parent_no,m.position);
	
