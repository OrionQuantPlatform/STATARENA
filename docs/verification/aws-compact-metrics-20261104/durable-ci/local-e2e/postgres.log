	    SELECT encode(sha256(record_send(ROW(slot,label,source_key,value_type,flags))),'hex'),
	           slot,label,source_key,value_type,flags FROM distinct_definitions ORDER BY 1
	    ON CONFLICT(signature) DO NOTHING;
	    UPDATE pg_temp.statarena_metric_cells c SET definition=d.id FROM statarena_app.compact_half_definitions d
	    WHERE (c.slot,c.label,c.flags)=(d.slot,d.label,d.flags)
	      AND c.source_key IS NOT DISTINCT FROM d.source_key AND c.value_type IS NOT DISTINCT FROM d.value_type;
	    IF EXISTS(SELECT FROM pg_temp.statarena_metric_cells WHERE definition IS NULL) THEN
	        RAISE EXCEPTION 'Unverified compact half metric definition';
	    END IF;
	
	    INSERT INTO pg_temp.statarena_metric_groups(resource_id,parent_no,base_no,count,signature)
	    SELECT resource_id,parent_no,base_no,count(*)::int,encode(sha256(convert_to(string_agg(
	        position::text||','||definition||','||record_delta||','||in_wide::text,';' ORDER BY position),'UTF8')),'hex')
	    FROM pg_temp.statarena_metric_cells GROUP BY resource_id,parent_no,base_no;
	    WITH new_templates AS (
	        INSERT INTO statarena_app.compact_half_templates(signature,member_count)
	        SELECT DISTINCT signature,count FROM pg_temp.statarena_metric_groups ORDER BY 1,2
	        ON CONFLICT(signature) DO NOTHING RETURNING id,signature
	    ), representative AS (
	        SELECT DISTINCT ON(g.signature) g.resource_id,g.parent_no,n.id FROM pg_temp.statarena_metric_groups g
	        JOIN new_templates n USING(signature) ORDER BY g.signature,g.resource_id,g.parent_no
	    )
	    INSERT INTO statarena_app.compact_half_members(template,position,definition,record_delta,in_wide)
	    SELECT r.id,c.position,c.definition,c.record_delta,c.in_wide FROM representative r
	    JOIN pg_temp.statarena_metric_cells c USING(resource_id,parent_no);
	    UPDATE pg_temp.statarena_metric_groups g SET template=t.id FROM statarena_app.compact_half_templates t
