	CREATE OR REPLACE FUNCTION statarena_app.begin_metric_batch() RETURNS void
	LANGUAGE plpgsql SET search_path=pg_catalog,pg_temp AS $function$
	BEGIN
	    IF to_regclass('pg_temp.statarena_metric_input') IS NULL THEN
	        CREATE TEMP TABLE statarena_metric_input (
	            resource_id bigint NOT NULL,record_no integer NOT NULL,missing text[] NOT NULL,null_groups text[] NOT NULL,
	            parent_no integer NOT NULL,position integer NOT NULL,metric_label text COLLATE "C" NOT NULL,key text COLLATE "C",
	            stat_type text COLLATE "C",stat_value float8,stat_total float8
	        ) ON COMMIT DROP;
	        CREATE TEMP TABLE statarena_metric_cells (
	            resource_id bigint NOT NULL,parent_no integer NOT NULL,position integer NOT NULL,base_no integer NOT NULL,
	            record_delta integer NOT NULL,slot smallint NOT NULL,label text COLLATE "C" NOT NULL,source_key text COLLATE "C",value_type text COLLATE "C",
	            flags smallint NOT NULL,v float8,t float8,in_wide boolean NOT NULL,overflow boolean NOT NULL,definition integer
	        ) ON COMMIT DROP;
