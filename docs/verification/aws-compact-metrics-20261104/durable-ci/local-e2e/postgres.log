	            resource_id bigint NOT NULL,parent_no integer NOT NULL,base_no integer NOT NULL,count integer NOT NULL,
	            signature char(64) NOT NULL,template integer,PRIMARY KEY(resource_id,parent_no)
	        ) ON COMMIT DROP;
	    ELSE
	        TRUNCATE pg_temp.statarena_metric_input,pg_temp.statarena_metric_cells,pg_temp.statarena_metric_groups;
	    END IF;
