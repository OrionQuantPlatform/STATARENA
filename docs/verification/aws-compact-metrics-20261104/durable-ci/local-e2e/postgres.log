	CREATE OR REPLACE FUNCTION statarena_app.finish_player_metric_batch() RETURNS void
	LANGUAGE plpgsql SET search_path=pg_catalog,pg_temp AS $function$
	BEGIN
	    INSERT INTO pg_temp.statarena_metric_cells(resource_id,parent_no,position,base_no,record_delta,slot,
	           label,source_key,value_type,flags,v,t,in_wide,overflow)
	    WITH tagged AS (
	        SELECT r.*,coalesce(s.slot,-1)::smallint AS slot,s.small_v,s.has_t,s.small_t,
	            min(r.record_no) OVER (PARTITION BY r.resource_id,r.parent_no) AS base_no,
	            row_number() OVER(PARTITION BY r.resource_id,r.parent_no,s.slot ORDER BY r.position) AS instance,
	            (CASE WHEN 'key'=ANY(r.missing) THEN 1 ELSE 0 END + CASE WHEN 'stat'=ANY(r.missing) THEN 2 ELSE 0 END + CASE WHEN 'stat.type'=ANY(r.missing) THEN 4 ELSE 0 END + CASE WHEN 'stat.value'=ANY(r.missing) THEN 8 ELSE 0 END + CASE WHEN 'stat.total'=ANY(r.missing) THEN 16 ELSE 0 END + CASE WHEN 'stat'=ANY(r.null_groups) THEN 32 ELSE 0 END)::smallint AS flags
	        FROM pg_temp.statarena_metric_input r LEFT JOIN (VALUES
	            ('Offsides',NULL::text,1::smallint,true,false,false),
	            ('ShotsOffTarget',NULL::text,2::smallint,true,false,false),
	            ('ShotsOnTarget',NULL::text,3::smallint,true,false,false),
	            ('accurate_crosses',NULL::text,4::smallint,true,true,true),
	            ('accurate_passes',NULL::text,5::smallint,true,true,true),
	            ('aerials_won',NULL::text,6::smallint,true,true,true),
	            ('assists',NULL::text,7::smallint,true,false,false),
	            ('big_chance_created_team_title',NULL::text,8::smallint,true,false,false),
	            ('big_chance_missed_title',NULL::text,9::smallint,true,false,false),
	            ('blocked_shots',NULL::text,10::smallint,true,false,false),
	            ('chances_created',NULL::text,11::smallint,true,false,false),
	            ('clearance_off_the_line',NULL::text,12::smallint,true,false,false),
	            ('clearances',NULL::text,13::smallint,true,false,false),
	            ('conceded_penalties',NULL::text,14::smallint,true,false,false),
	            ('corners',NULL::text,15::smallint,true,false,false),
	            ('defensive_actions',NULL::text,16::smallint,true,false,false),
	            ('dispossessed',NULL::text,17::smallint,true,false,false),
	            ('dribbled_past',NULL::text,18::smallint,true,false,false),
	            ('dribbles_succeeded',NULL::text,19::smallint,true,true,true),
	            ('duel_lost',NULL::text,20::smallint,true,false,false),
	            ('duel_won',NULL::text,21::smallint,true,false,false),
	            ('errors_led_to_goal',NULL::text,22::smallint,true,false,false),
	            ('expected_assists',NULL::text,23::smallint,false,false,false),
	            ('expected_goals',NULL::text,24::smallint,false,false,false),
	            ('expected_goals_non_penalty',NULL::text,25::smallint,false,false,false),
	            ('expected_goals_on_target_faced',NULL::text,26::smallint,false,false,false),
	            ('expected_goals_on_target_variant',NULL::text,27::smallint,false,false,false),
	            ('fouls',NULL::text,28::smallint,true,false,false),
	            ('goals',NULL::text,29::smallint,true,false,false),
	            ('goals_conceded',NULL::text,30::smallint,true,false,false),
	            ('goals_prevented',NULL::text,31::smallint,false,false,false),
	            ('ground_duels_won',NULL::text,32::smallint,true,true,true),
	            ('headed_clearance',NULL::text,33::smallint,true,false,false),
	            ('interceptions',NULL::text,34::smallint,true,false,false),
	            ('keeper_diving_save',NULL::text,35::smallint,true,false,false),
	            ('keeper_high_claim',NULL::text,36::smallint,true,false,false),
	            ('keeper_sweeper',NULL::text,37::smallint,true,false,false),
	            ('last_man_tackle',NULL::text,38::smallint,true,false,false),
	            ('long_balls_accurate',NULL::text,39::smallint,true,true,true),
	            ('matchstats.headers.tackles',NULL::text,40::smallint,true,false,false),
	            ('minutes_played',NULL::text,41::smallint,true,false,false),
	            ('missed_penalty',NULL::text,42::smallint,true,false,false),
	            ('owngoal',NULL::text,43::smallint,true,false,false),
	            ('passes_into_final_third',NULL::text,44::smallint,true,false,false),
	            ('penalties_won',NULL::text,45::smallint,true,false,false),
	            ('player_throws',NULL::text,46::smallint,true,false,false),
	            ('punches',NULL::text,47::smallint,true,false,false),
	            ('rating_title',NULL::text,48::smallint,false,false,false),
	            ('recoveries',NULL::text,49::smallint,true,false,false),
	            ('saved_penalties',NULL::text,50::smallint,true,false,false),
	            ('saves',NULL::text,51::smallint,true,false,false),
	            ('saves_inside_box',NULL::text,52::smallint,true,false,false),
	            ('shot_accuracy',NULL::text,53::smallint,true,true,true),
	            ('shot_blocks',NULL::text,54::smallint,true,false,false),
	            ('','Shotmap',55::smallint,true,false,false),
	            ('shots_woodwork',NULL::text,56::smallint,true,false,false),
	            ('total_shots',NULL::text,57::smallint,true,false,false),
	            ('touches',NULL::text,58::smallint,true,false,false),
	            ('touches_opp_box',NULL::text,59::smallint,true,false,false),
	            ('was_fouled',NULL::text,60::smallint,true,false,false),
	            ('xg_and_xa',NULL::text,61::smallint,false,false,false)
	        ) s(source_key,only_label,slot,small_v,has_t,small_t)
	        ON s.source_key=r.key AND (s.only_label IS NULL OR s.only_label=r.metric_label)
	    )
	    SELECT resource_id,parent_no,position,base_no,record_no-base_no,slot,metric_label,key,stat_type,
	           flags,stat_value,stat_total,slot>0 AND instance=1,
	           slot<0 OR instance<>1 OR (small_v AND NOT (stat_value IS NULL OR (stat_value BETWEEN -32768 AND 32767 AND stat_value=trunc(stat_value) AND (stat_value<>0 OR float8send(stat_value)=float8send(0::float8)))))
	           OR (stat_total IS NOT NULL AND (NOT has_t OR (small_t AND NOT (stat_total IS NULL OR (stat_total BETWEEN -32768 AND 32767 AND stat_total=trunc(stat_total) AND (stat_total<>0 OR float8send(stat_total)=float8send(0::float8)))))))
	    FROM tagged;
	
	    -- Separate commands allow a conflicting INSERT to commit before the ID lookup,
	    -- and stable insertion order avoids lock inversions within a dictionary batch.
	    WITH distinct_definitions AS (
	        SELECT DISTINCT slot,label,source_key,value_type,flags FROM pg_temp.statarena_metric_cells
	    )
	    INSERT INTO statarena_app.compact_player_definitions(signature,slot,label,source_key,value_type,flags)
	    SELECT encode(sha256(record_send(ROW(slot,label,source_key,value_type,flags))),'hex'),
	           slot,label,source_key,value_type,flags FROM distinct_definitions ORDER BY 1
	    ON CONFLICT(signature) DO NOTHING;
	    UPDATE pg_temp.statarena_metric_cells c SET definition=d.id FROM statarena_app.compact_player_definitions d
	    WHERE (c.slot,c.label,c.flags)=(d.slot,d.label,d.flags)
	      AND c.source_key IS NOT DISTINCT FROM d.source_key AND c.value_type IS NOT DISTINCT FROM d.value_type;
	    IF EXISTS(SELECT FROM pg_temp.statarena_metric_cells WHERE definition IS NULL) THEN
	        RAISE EXCEPTION 'Unverified compact player metric definition';
	    END IF;
	
	    INSERT INTO pg_temp.statarena_metric_groups(resource_id,parent_no,base_no,count,signature)
	    SELECT resource_id,parent_no,base_no,count(*)::int,encode(sha256(convert_to(string_agg(
	        position::text||','||definition||','||record_delta||','||in_wide::text,';' ORDER BY position),'UTF8')),'hex')
	    FROM pg_temp.statarena_metric_cells GROUP BY resource_id,parent_no,base_no;
	    WITH new_templates AS (
	        INSERT INTO statarena_app.compact_player_templates(signature,member_count)
	        SELECT DISTINCT signature,count FROM pg_temp.statarena_metric_groups ORDER BY 1,2
	        ON CONFLICT(signature) DO NOTHING RETURNING id,signature
	    ), representative AS (
	        SELECT DISTINCT ON(g.signature) g.resource_id,g.parent_no,n.id FROM pg_temp.statarena_metric_groups g
	        JOIN new_templates n USING(signature) ORDER BY g.signature,g.resource_id,g.parent_no
	    )
	    INSERT INTO statarena_app.compact_player_members(template,position,definition,record_delta,in_wide)
	    SELECT r.id,c.position,c.definition,c.record_delta,c.in_wide FROM representative r
	    JOIN pg_temp.statarena_metric_cells c USING(resource_id,parent_no);
	    UPDATE pg_temp.statarena_metric_groups g SET template=t.id FROM statarena_app.compact_player_templates t
	     WHERE t.signature=g.signature AND t.member_count=g.count;
	
	    -- A digest is an index, not the source of truth. Check exact typed membership
	    -- before sharing a template (also detects an inconsistent dictionary).
	    IF EXISTS (
	        SELECT FROM pg_temp.statarena_metric_cells c JOIN pg_temp.statarena_metric_groups g USING(resource_id,parent_no)
	        LEFT JOIN statarena_app.compact_player_members m ON m.template=g.template AND m.position=c.position
	        WHERE m.definition IS NULL OR (m.definition,m.record_delta,m.in_wide)
	        IS DISTINCT FROM (c.definition,c.record_delta,c.in_wide)
	    ) THEN RAISE EXCEPTION 'Unverified compact player metric template'; END IF;
	
	    INSERT INTO statarena_app.compact_player_groups(resource_id,parent_no,template,base_no,offsides,shots_off_target,shots_on_target,accurate_crosses,accurate_crosses_total,accurate_passes,accurate_passes_total,aerials_won,aerials_won_total,assists,big_chance_created_team_title,big_chance_missed_title,blocked_shots,chances_created,clearance_off_the_line,clearances,conceded_penalties,corners,defensive_actions,dispossessed,dribbled_past,dribbles_succeeded,dribbles_succeeded_total,duel_lost,duel_won,errors_led_to_goal,expected_assists,expected_goals,expected_goals_non_penalty,expected_goals_on_target_faced,expected_goals_on_target_variant,fouls,goals,goals_conceded,goals_prevented,ground_duels_won,ground_duels_won_total,headed_clearance,interceptions,keeper_diving_save,keeper_high_claim,keeper_sweeper,last_man_tackle,long_balls_accurate,long_balls_accurate_total,matchstats_headers_tackles,minutes_played,missed_penalty,owngoal,passes_into_final_third,penalties_won,player_throws,punches,rating_title,recoveries,saved_penalties,saves,saves_inside_box,shot_accuracy,shot_accuracy_total,shot_blocks,shotmap_flag,shots_woodwork,total_shots,touches,touches_opp_box,was_fouled,xg_and_xa)
	    SELECT c.resource_id,c.parent_no,g.template,c.base_no,
	        max(c.v) FILTER (WHERE c.slot=1 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=2 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=3 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=4 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=4 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=5 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=5 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=6 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=6 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=7 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=8 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=9 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=10 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=11 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=12 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=13 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=14 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=15 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=16 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=17 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=18 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=19 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=19 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=20 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=21 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=22 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=23 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=24 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=25 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=26 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=27 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=28 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=29 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=30 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=31 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=32 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=32 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=33 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=34 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=35 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=36 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=37 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=38 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=39 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=39 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=40 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=41 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=42 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=43 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=44 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=45 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=46 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=47 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=48 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=49 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=50 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=51 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=52 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=53 AND c.in_wide AND NOT c.overflow),
	        max(c.t) FILTER (WHERE c.slot=53 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=54 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=55 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=56 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=57 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=58 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=59 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=60 AND c.in_wide AND NOT c.overflow),
	        max(c.v) FILTER (WHERE c.slot=61 AND c.in_wide AND NOT c.overflow)
	    FROM pg_temp.statarena_metric_cells c JOIN pg_temp.statarena_metric_groups g USING(resource_id,parent_no)
	    GROUP BY c.resource_id,c.parent_no,g.template,c.base_no;
	    INSERT INTO statarena_app.compact_player_overflow(resource_id,parent_no,position,v,t)
	    SELECT resource_id,parent_no,position,v,t FROM pg_temp.statarena_metric_cells WHERE overflow;
	END
	$function$;
	
	CREATE OR REPLACE VIEW statarena_app.compact_player_rows AS
	SELECT w.resource_id,w.base_no+m.record_delta AS record_no,array_remove(ARRAY[CASE WHEN (d.flags & 1)<>0 THEN 'key' END,CASE WHEN (d.flags & 2)<>0 THEN 'stat' END,CASE WHEN (d.flags & 4)<>0 THEN 'stat.type' END,CASE WHEN (d.flags & 8)<>0 THEN 'stat.value' END,CASE WHEN (d.flags & 16)<>0 THEN 'stat.total' END],NULL) AS missing,
	       CASE WHEN (d.flags & 32)<>0 THEN ARRAY['stat'] ELSE ARRAY[]::text[] END AS null_groups,
	       w.parent_no,m.position,d.label AS metric_label,d.source_key AS key,d.value_type AS stat_type,
	       CASE WHEN x.position IS NOT NULL THEN x.v ELSE CASE d.slot WHEN 1 THEN w.offsides::float8 WHEN 2 THEN w.shots_off_target::float8 WHEN 3 THEN w.shots_on_target::float8 WHEN 4 THEN w.accurate_crosses::float8 WHEN 5 THEN w.accurate_passes::float8 WHEN 6 THEN w.aerials_won::float8 WHEN 7 THEN w.assists::float8 WHEN 8 THEN w.big_chance_created_team_title::float8 WHEN 9 THEN w.big_chance_missed_title::float8 WHEN 10 THEN w.blocked_shots::float8 WHEN 11 THEN w.chances_created::float8 WHEN 12 THEN w.clearance_off_the_line::float8 WHEN 13 THEN w.clearances::float8 WHEN 14 THEN w.conceded_penalties::float8 WHEN 15 THEN w.corners::float8 WHEN 16 THEN w.defensive_actions::float8 WHEN 17 THEN w.dispossessed::float8 WHEN 18 THEN w.dribbled_past::float8 WHEN 19 THEN w.dribbles_succeeded::float8 WHEN 20 THEN w.duel_lost::float8 WHEN 21 THEN w.duel_won::float8 WHEN 22 THEN w.errors_led_to_goal::float8 WHEN 23 THEN w.expected_assists::float8 WHEN 24 THEN w.expected_goals::float8 WHEN 25 THEN w.expected_goals_non_penalty::float8 WHEN 26 THEN w.expected_goals_on_target_faced::float8 WHEN 27 THEN w.expected_goals_on_target_variant::float8 WHEN 28 THEN w.fouls::float8 WHEN 29 THEN w.goals::float8 WHEN 30 THEN w.goals_conceded::float8 WHEN 31 THEN w.goals_prevented::float8 WHEN 32 THEN w.ground_duels_won::float8 WHEN 33 THEN w.headed_clearance::float8 WHEN 34 THEN w.interceptions::float8 WHEN 35 THEN w.keeper_diving_save::float8 WHEN 36 THEN w.keeper_high_claim::float8 WHEN 37 THEN w.keeper_sweeper::float8 WHEN 38 THEN w.last_man_tackle::float8 WHEN 39 THEN w.long_balls_accurate::float8 WHEN 40 THEN w.matchstats_headers_tackles::float8 WHEN 41 THEN w.minutes_played::float8 WHEN 42 THEN w.missed_penalty::float8 WHEN 43 THEN w.owngoal::float8 WHEN 44 THEN w.passes_into_final_third::float8 WHEN 45 THEN w.penalties_won::float8 WHEN 46 THEN w.player_throws::float8 WHEN 47 THEN w.punches::float8 WHEN 48 THEN w.rating_title::float8 WHEN 49 THEN w.recoveries::float8 WHEN 50 THEN w.saved_penalties::float8 WHEN 51 THEN w.saves::float8 WHEN 52 THEN w.saves_inside_box::float8 WHEN 53 THEN w.shot_accuracy::float8 WHEN 54 THEN w.shot_blocks::float8 WHEN 55 THEN w.shotmap_flag::float8 WHEN 56 THEN w.shots_woodwork::float8 WHEN 57 THEN w.total_shots::float8 WHEN 58 THEN w.touches::float8 WHEN 59 THEN w.touches_opp_box::float8 WHEN 60 THEN w.was_fouled::float8 WHEN 61 THEN w.xg_and_xa::float8 END END AS stat_value, CASE WHEN x.position IS NOT NULL THEN x.t ELSE CASE d.slot WHEN 4 THEN w.accurate_crosses_total::float8 WHEN 5 THEN w.accurate_passes_total::float8 WHEN 6 THEN w.aerials_won_total::float8 WHEN 19 THEN w.dribbles_succeeded_total::float8 WHEN 32 THEN w.ground_duels_won_total::float8 WHEN 39 THEN w.long_balls_accurate_total::float8 WHEN 53 THEN w.shot_accuracy_total::float8 END END AS stat_total
	FROM statarena_app.compact_player_groups w JOIN statarena_app.compact_player_members m ON m.template=w.template
	JOIN statarena_app.compact_player_definitions d ON d.id=m.definition
	LEFT JOIN statarena_app.compact_player_overflow x ON (x.resource_id,x.parent_no,x.position)=(w.resource_id,w.parent_no,m.position);
	
	-- Backfill existing derived metrics
	DO $backfill$
	DECLARE batch bigint[]; last_id bigint;
	BEGIN
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.half_stat_metrics'::regclass) THEN LOCK TABLE statarena_app.half_stat_metrics IN SHARE MODE; END IF;
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.player_stat_metrics'::regclass) THEN LOCK TABLE statarena_app.player_stat_metrics IN SHARE MODE; END IF;
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.half_stat_metrics'::regclass) THEN
	    last_id := NULL;
	    LOOP
	        SELECT array_agg(id ORDER BY id) INTO batch FROM (
	            SELECT DISTINCT resource_id AS id FROM statarena_app.half_stat_metrics WHERE last_id IS NULL OR resource_id>last_id
	            ORDER BY id LIMIT 16
	        ) q;
	        EXIT WHEN batch IS NULL;
	        PERFORM statarena_app.begin_metric_batch();
	        INSERT INTO pg_temp.statarena_metric_input SELECT * FROM statarena_app.half_stat_metrics WHERE resource_id=ANY(batch);
	        PERFORM statarena_app.finish_half_metric_batch();
	        last_id := batch[cardinality(batch)];
	    END LOOP;
	    IF EXISTS (SELECT * FROM statarena_app.half_stat_metrics EXCEPT ALL SELECT * FROM statarena_app.compact_half_rows) OR
	       EXISTS (SELECT * FROM statarena_app.compact_half_rows EXCEPT ALL SELECT * FROM statarena_app.half_stat_metrics) THEN
	        RAISE EXCEPTION 'Refusing half metric cutover: native typed row difference';
	    END IF;
	END IF;
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.player_stat_metrics'::regclass) THEN
	    last_id := NULL;
	    LOOP
	        SELECT array_agg(id ORDER BY id) INTO batch FROM (
	            SELECT DISTINCT resource_id AS id FROM statarena_app.player_stat_metrics WHERE last_id IS NULL OR resource_id>last_id
	            ORDER BY id LIMIT 16
	        ) q;
	        EXIT WHEN batch IS NULL;
	        PERFORM statarena_app.begin_metric_batch();
	        INSERT INTO pg_temp.statarena_metric_input SELECT * FROM statarena_app.player_stat_metrics WHERE resource_id=ANY(batch);
	        PERFORM statarena_app.finish_player_metric_batch();
	        last_id := batch[cardinality(batch)];
	    END LOOP;
	    IF EXISTS (SELECT * FROM statarena_app.player_stat_metrics EXCEPT ALL SELECT * FROM statarena_app.compact_player_rows) OR
	       EXISTS (SELECT * FROM statarena_app.compact_player_rows EXCEPT ALL SELECT * FROM statarena_app.player_stat_metrics) THEN
	        RAISE EXCEPTION 'Refusing player metric cutover: native typed row difference';
	    END IF;
	END IF;
	END
	$backfill$;
	
	DO $cutover$
	DECLARE old_heap oid; rights record; previous_timeout text := current_setting('lock_timeout');
	BEGIN
	    IF previous_timeout::interval=interval '0' OR previous_timeout::interval>interval '250 milliseconds' THEN
	        PERFORM set_config('lock_timeout','250ms',true);
	    END IF;
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.half_stat_metrics'::regclass) THEN LOCK TABLE statarena_app.half_stat_metrics IN ACCESS EXCLUSIVE MODE; END IF;
	IF (SELECT relkind='r' FROM pg_class WHERE oid='statarena_app.player_stat_metrics'::regclass) THEN LOCK TABLE statarena_app.player_stat_metrics IN ACCESS EXCLUSIVE MODE; END IF;
	SELECT oid INTO old_heap FROM pg_class WHERE oid='statarena_app.half_stat_metrics'::regclass AND relkind='r';
	IF old_heap IS NOT NULL THEN
	    ALTER TABLE statarena_app.half_stat_metrics RENAME TO half_stat_metrics_before_009;
	    CREATE VIEW statarena_app.half_stat_metrics AS SELECT * FROM statarena_app.compact_half_rows;
	    FOR rights IN SELECT a.grantee,a.is_grantable FROM pg_class c,
	          LATERAL aclexplode(c.relacl) a WHERE c.oid=old_heap AND a.privilege_type='SELECT' AND a.grantee<>c.relowner
	    LOOP
	        EXECUTE 'GRANT SELECT ON statarena_app.half_stat_metrics TO '||CASE WHEN rights.grantee=0 THEN 'PUBLIC'
	                ELSE quote_ident(pg_get_userbyid(rights.grantee)) END||
	                CASE WHEN rights.is_grantable THEN ' WITH GRANT OPTION' ELSE '' END;
	    END LOOP;
	    DROP TABLE statarena_app.half_stat_metrics_before_009 RESTRICT;
	END IF;
	SELECT oid INTO old_heap FROM pg_class WHERE oid='statarena_app.player_stat_metrics'::regclass AND relkind='r';
	IF old_heap IS NOT NULL THEN
	    ALTER TABLE statarena_app.player_stat_metrics RENAME TO player_stat_metrics_before_009;
	    CREATE VIEW statarena_app.player_stat_metrics AS SELECT * FROM statarena_app.compact_player_rows;
	    FOR rights IN SELECT a.grantee,a.is_grantable FROM pg_class c,
	          LATERAL aclexplode(c.relacl) a WHERE c.oid=old_heap AND a.privilege_type='SELECT' AND a.grantee<>c.relowner
	    LOOP
	        EXECUTE 'GRANT SELECT ON statarena_app.player_stat_metrics TO '||CASE WHEN rights.grantee=0 THEN 'PUBLIC'
	                ELSE quote_ident(pg_get_userbyid(rights.grantee)) END||
	                CASE WHEN rights.is_grantable THEN ' WITH GRANT OPTION' ELSE '' END;
	    END LOOP;
	    DROP TABLE statarena_app.player_stat_metrics_before_009 RESTRICT;
	END IF;
	    PERFORM set_config('lock_timeout',previous_timeout,true);
	END
