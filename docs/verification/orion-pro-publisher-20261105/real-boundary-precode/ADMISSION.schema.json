{
  "$defs": {
    "commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "id": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:statarena:real-four-readers-publication-admission:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reject duplicate JSON keys, nonfinite values, float/bool IDs and unknown keys in the parser before applying this schema. Every SHA must resolve to actual reviewed evidence. No fixtureOnly, local labels, credentials or raw DSN are accepted.",
  "properties": {
    "admissionPhase": {
      "additionalProperties": false,
      "properties": {
        "codeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "generation": {
          "$ref": "#/$defs/id"
        },
        "inputClosureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outputClosureSha256": {
          "$ref": "#/$defs/sha256"
        },
        "receiptSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rulesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshotId": {
          "$ref": "#/$defs/id"
        },
        "sourcePolicy": {
          "const": "real_source_core_v2_native31"
        },
        "version": {
          "const": "real_core_four_readers_admission_v1"
        }
      },
      "required": [
        "version",
        "commit",
        "codeSha256",
        "receiptSha256",
        "inputClosureSha256",
        "outputClosureSha256",
        "generation",
        "snapshotId",
        "sourcePolicy",
        "rulesSha256"
      ],
      "type": "object"
    },
    "catalogue": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/id"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshotId": {
          "$ref": "#/$defs/id"
        },
        "sourcePriorityVersion": {
          "const": "real_source_core_v2_native31"
        }
      },
      "required": [
        "snapshotId",
        "generation",
        "manifestSha256",
        "sourcePriorityVersion"
      ],
      "type": "object"
    },
    "dataOrigin": {
      "const": "existing_aws_saved_observations"
    },
    "dataset": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "$ref": "#/$defs/id"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "snapshotId": {
          "$ref": "#/$defs/id"
        },
        "sourcePriorityVersion": {
          "const": "real_source_core_v2_native31"
        }
      },
      "required": [
        "snapshotId",
        "generation",
        "manifestSha256",
        "sourcePriorityVersion"
      ],
      "type": "object"
    },
    "dependencyScheme": {
      "const": "orion-four-readers-dependencies-v1"
    },
    "editions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "admissionInputClosureSha256": {
            "$ref": "#/$defs/sha256"
          },
          "cohortSha256": {
            "$ref": "#/$defs/sha256"
          },
          "competitionId": {
            "$ref": "#/$defs/id"
          },
          "completeUsefulCohort": {
            "const": true
          },
          "editionId": {
            "$ref": "#/$defs/id"
          },
          "editionRevisionId": {
            "$ref": "#/$defs/id"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "coverageProofSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "factClosureSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "fieldStateProofSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "matchId": {
                  "$ref": "#/$defs/id"
                },
                "matchRevisionId": {
                  "$ref": "#/$defs/id"
                },
                "publicId": {
                  "pattern": "^m_[A-Za-z0-9]{6}$",
                  "type": "string"
                },
                "publicationState": {
                  "const": "published"
                },
                "sourceId": {
                  "$ref": "#/$defs/id"
                },
                "sourceRecordId": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "matchId",
                "matchRevisionId",
                "publicId",
                "sourceId",
                "sourceRecordId",
                "publicationState",
                "factClosureSha256",
                "coverageProofSha256",
                "fieldStateProofSha256"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "publicLeagueId": {
            "pattern": "^l_[A-Za-z0-9]{6}$",
            "type": "string"
          },
          "season": {
            "pattern": "^[0-9]{4}(/[0-9]{4})?$",
            "type": "string"
          }
        },
        "required": [
          "editionId",
          "editionRevisionId",
          "competitionId",
          "publicLeagueId",
          "season",
          "completeUsefulCohort",
          "members",
          "cohortSha256",
          "admissionInputClosureSha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "endpoint": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "const": "statarena_ingest"
        },
        "address": {
          "minLength": 3,
          "type": "string"
        },
        "caSha256": {
          "$ref": "#/$defs/sha256"
        },
        "database": {
          "const": "statarena_prod"
        },
        "dnsAddressSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "hostname": {
          "const": "statarena-postgres.clcy2iqyajbl.us-east-2.rds.amazonaws.com"
        },
        "nativePolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "port": {
          "const": 5432
        },
        "postmasterStartedAt": {
          "format": "date-time",
          "type": "string"
        },
        "readbackSha256": {
          "$ref": "#/$defs/sha256"
        },
        "serverVersion": {
          "const": 180006
        },
        "sslmode": {
          "const": "verify-full"
        }
      },
      "required": [
        "hostname",
        "address",
        "dnsAddressSetSha256",
        "port",
        "database",
        "actor",
        "sslmode",
        "caSha256",
        "serverVersion",
        "postmasterStartedAt",
        "nativePolicySha256",
        "readbackSha256"
      ],
      "type": "object"
    },
    "fullAcceptance": {
      "const": false
    },
    "kind": {
      "const": "orion_real_four_readers_publication_admission_v1"
    },
    "modelSha256": {
      "const": "18da43f940870b7a3a3cb49323c847dd5e5174e5eea1f8ff0c8a159cf373cb08"
    },
    "profilePolicy": {
      "const": "same-source-provider-exact-normalized-manual-v1"
    },
    "publisher": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "environmentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "metricsContractVersion": {
          "const": "orion_pro_four_readers_v1"
        },
        "transformVersion": {
          "const": "orion_pro_publish_real_v1"
        }
      },
      "required": [
        "commit",
        "contentSha256",
        "environmentSha256",
        "transformVersion",
        "metricsContractVersion"
      ],
      "type": "object"
    },
    "representationVersion": {
      "const": "summary-v1-shots-v1"
    },
    "rootReleaseSha256": {
      "$ref": "#/$defs/sha256"
    },
    "schemaVersion": {
      "const": 1
    },
    "scorePolicy": {
      "const": "final_without_shootout_separate_shootout_v1"
    },
    "sourceFieldMatrixSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourcePolicy": {
      "const": "real_source_core_v2_native31"
    },
    "sourceReconciliationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "ready_for_publication"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "coreCheckpointSha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin": {
          "const": "real_native_sql_checkpoint"
        },
        "sourceNative31Sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceNative94Sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceProducerSha256": {
          "const": "4b98a829bc7e32e11a7e66381ffecae6248ce536d17771aa080502374fe844bc"
        },
        "sourceProducerVersion": {
          "const": "real_source_core_v2_native31"
        },
        "sourceTargetMappingSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetNative31ReadbackSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetNative94ReadbackSha256": {
          "$ref": "#/$defs/sha256"
        },
        "transportReceiptSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "origin",
        "coreCheckpointSha256",
        "sourceNative94Sha256",
        "sourceNative31Sha256",
        "transportReceiptSha256",
        "sourceTargetMappingSha256",
        "targetNative94ReadbackSha256",
        "targetNative31ReadbackSha256",
        "sourceProducerSha256",
        "sourceProducerVersion"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "dataOrigin",
    "status",
    "fullAcceptance",
    "modelSha256",
    "representationVersion",
    "dependencyScheme",
    "sourcePolicy",
    "scorePolicy",
    "profilePolicy",
    "transport",
    "admissionPhase",
    "dataset",
    "catalogue",
    "publisher",
    "endpoint",
    "editions",
    "sourceFieldMatrixSha256",
    "sourceReconciliationSha256",
    "rootReleaseSha256"
  ],
  "title": "Unpopulated real RDS admission contract; not an acceptance receipt",
  "type": "object"
}
