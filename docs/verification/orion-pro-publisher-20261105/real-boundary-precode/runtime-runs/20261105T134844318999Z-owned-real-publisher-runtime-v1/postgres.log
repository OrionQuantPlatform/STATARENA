	CREATE CONSTRAINT TRIGGER "pro_graph_commit" AFTER INSERT OR UPDATE OR DELETE ON "ingest"."sources" DEFERRABLE INITIALLY DEFERRED
	FOR EACH ROW EXECUTE FUNCTION "ingest"."pro_graph_commit"();
	
