	CREATE OR REPLACE FUNCTION "ingest"."selected_at"(g bigint, from_gen bigint, to_gen bigint) RETURNS boolean
	LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog IMMUTABLE PARALLEL SAFE
