    {
      "name": "exact_shot_identity_and_source_locator",
      "sql": "WITH raw AS MATERIALIZED (WITH wanted(match_key,actor,team_key,shot_key,locator) AS (VALUES (%s,%s,%s,%s,%s),(%s,%s,%s,%s,%s),(%s,%s,%s,%s,%s),(%s,%s,%s,%s,%s)) SELECT w.*,s.id shot_id,s.revision_id,s.match_id,s.team_id,s.player_id,s.player_profile_version_id,s.source_record_id,s.source_ordinal,s.recorded_from_gen,r.locator sql_locator,d.legacy_object_path,d.content_sha256\n FROM wanted w LEFT JOIN LATERAL (SELECT s.* FROM football.shots s JOIN ingest.source_records r ON r.id=s.source_record_id JOIN ingest.source_documents d ON d.id=r.document_id\n  WHERE s.external_shot_id=w.shot_key AND r.locator=w.locator AND d.legacy_object_path=%s AND d.content_sha256=%s ORDER BY s.id LIMIT 2) s ON true\n LEFT JOIN ingest.source_records r ON r.id=s.source_record_id LEFT JOIN ingest.source_documents d ON d.id=r.document_id ORDER BY w.shot_key),encoded AS MATERIALIZED (SELECT row_to_json(raw)::text v,row_number() OVER() ordinal FROM raw),measured AS (SELECT count(*) n,coalesce(sum(octet_length(v)),0)+greatest(count(*)-1,0)+2 bytes FROM encoded) SELECT CASE WHEN n<=%s AND bytes<=%s THEN (SELECT '['||coalesce(string_agg(v,',' ORDER BY ordinal),'')||']' FROM encoded) END,n,bytes FROM measured",
