      "sql": "WITH raw AS MATERIALIZED (SELECT current_database() db,current_user actor,session_user session_actor,current_setting('server_version_num') version,current_setting('transaction_read_only') ro,current_setting('transaction_isolation') isolation,current_setting('statement_timeout') statement,current_setting('lock_timeout') lock,(SELECT ssl FROM pg_stat_ssl WHERE pid=pg_backend_pid()) tls,pg_postmaster_start_time()::text started),encoded AS MATERIALIZED (SELECT row_to_json(raw)::text v,row_number() OVER() ordinal FROM raw),measured AS (SELECT count(*) n,coalesce(sum(octet_length(v)),0)+greatest(count(*)-1,0)+2 bytes FROM encoded) SELECT CASE WHEN n<=%s AND bytes<=%s THEN (SELECT '['||coalesce(string_agg(v,',' ORDER BY ordinal),'')||']' FROM encoded) END,n,bytes FROM measured",
