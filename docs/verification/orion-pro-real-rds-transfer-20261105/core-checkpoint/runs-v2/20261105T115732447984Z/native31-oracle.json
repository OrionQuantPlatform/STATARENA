  "sql": {
    "wide": "SELECT d.legacy_object_path,r.external_key,r.locator,s.source_record_id,s.revision_id,s.match_id,s.player_id,s.team_id,s.match_player_revision_id,s.source_id,s.period_code,s.period_definition_version,s.variant_key,s.recorded_from_gen,s.aerial_duels_attempted,s.aerial_duels_won,s.assists,s.big_chances_created,s.blocks,s.chances_created,s.clearances,s.defensive_actions,s.dribbles_completed,s.dribbles_attempted,s.duels_lost,s.duels_won,s.goals,s.goals_prevented,s.interceptions,s.minutes_played,s.non_penalty_xg,s.passes_completed,s.passes_attempted,s.passes_final_third,s.provider_rating,s.recoveries,s.saves,s.shots,s.shots_on_target,s.tackles,s.touches,s.touches_box,s.xa,s.xg,s.xgot,ma.public_key,pa.public_key,ta.public_key FROM football.player_match_stats s JOIN ingest.source_records r ON r.id=s.source_record_id JOIN ingest.source_documents d ON d.id=r.document_id JOIN ingest.public_aliases_current ma ON ma.route_kind='match' AND ma.match_id=s.match_id JOIN ingest.public_aliases_current pa ON pa.route_kind='player' AND pa.player_id=s.player_id JOIN ingest.public_aliases_current ta ON ta.route_kind='team' AND ta.team_id=s.team_id WHERE s.is_canonical AND s.recorded_to_gen IS NULL ORDER BY s.source_record_id",
    "metric": "SELECT source_record_id,metric_code,value_kind,numeric_value,text_value,boolean_value,numerator,denominator,source_display,match_id,player_id,team_id,match_player_revision_id,source_id,period_code,period_definition_version,variant_key,recorded_from_gen,metric_definition_version FROM football.player_match_metric_values WHERE is_canonical AND recorded_to_gen IS NULL ORDER BY source_record_id,metric_code",
    "definitions": "SELECT code,unit,scope,aggregation,allows_negative FROM football.metric_definitions ORDER BY code",
    "mappings": "SELECT raw_key,metric_code,metric_definition_version,mapping_version,parse_rule->>'common_column',parse_rule->>'common_sql_type',parse_rule->>'number_projection' FROM football.source_metric_mappings WHERE family_code='normalized_performance' ORDER BY raw_key"
  }
