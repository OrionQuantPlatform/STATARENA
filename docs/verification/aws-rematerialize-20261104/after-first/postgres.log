	'shots', CASE WHEN 'shots'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('id', r1."id",
	'team_id', r1."team_id",
	'shot_type', r1."shot_type",
	'situation', r1."situation",
