	'shirt_number', r1."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r1.missing) THEN 'image_url' END, CASE WHEN 'player.position_id'=ANY(r1.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r1.missing) THEN 'shirt_number' END],NULL)) END,
	'sub_in_player', CASE WHEN 'sub_in_player'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."sub_in_player_id",
	'name', r1."sub_in_player_name",
	'image_url', r1."sub_in_player_image_url",
	'position_id', r1."sub_in_player_position_id",
	'shirt_number', r1."sub_in_player_shirt_number") - array_remove(ARRAY[CASE WHEN 'sub_in_player.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'sub_in_player.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'sub_in_player.image_url'=ANY(r1.missing) THEN 'image_url' END, CASE WHEN 'sub_in_player.position_id'=ANY(r1.missing) THEN 'position_id' END, CASE WHEN 'sub_in_player.shirt_number'=ANY(r1.missing) THEN 'shirt_number' END],NULL)) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.match_events r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.event_sheets r WHERE r.resource_id=rid;
