	CREATE OR REPLACE FUNCTION statarena_app.detail_response(f statarena_app.match_families)
	RETURNS jsonb LANGUAGE sql STABLE AS $$
	 SELECT jsonb_build_object('status', f.status)
	 || CASE WHEN f.has_data THEN jsonb_build_object('data', CASE f.family
	WHEN 'match' THEN statarena_app.detail_data_match(f.resource_id)
	WHEN 'events' THEN statarena_app.detail_data_events(f.resource_id)
	WHEN 'shots' THEN statarena_app.detail_data_shots(f.resource_id)
	WHEN 'stats' THEN statarena_app.detail_data_stats(f.resource_id)
	WHEN 'lineups' THEN statarena_app.detail_data_lineups(f.resource_id)
	WHEN 'players' THEN statarena_app.detail_data_players(f.resource_id)
	WHEN 'player_halves' THEN statarena_app.detail_data_player_halves(f.resource_id)
	WHEN 'momentum' THEN statarena_app.detail_data_momentum(f.resource_id)
	WHEN 'h2h' THEN statarena_app.detail_data_h2h(f.resource_id)
	WHEN 'advanced_teams' THEN statarena_app.detail_data_advanced_teams(f.resource_id)
	WHEN 'advanced_players' THEN statarena_app.detail_data_advanced_players(f.resource_id)
	WHEN 'pass_networks' THEN statarena_app.detail_data_pass_networks(f.resource_id)
	WHEN 'heatmaps' THEN statarena_app.detail_data_heatmaps(f.resource_id)
	WHEN 'player_shots' THEN statarena_app.detail_data_player_shots(f.resource_id)
	WHEN 'single_shot' THEN statarena_app.detail_data_shots(f.resource_id) #> '{periods,0,shots,0}'
	WHEN 'single_player' THEN statarena_app.detail_data_players(f.resource_id) -> 0
	WHEN 'single_halves' THEN (SELECT (payload #> '{players,0}') || (payload-'players') FROM statarena_app.detail_data_player_halves(f.resource_id) payload)
	WHEN 'single_advanced' THEN statarena_app.detail_data_advanced_players(f.resource_id) #> '{players,0}'
	END) ELSE '{}'::jsonb END
	 || CASE WHEN f.has_error THEN jsonb_build_object('error', CASE WHEN f.error_object THEN
	 (CASE WHEN f.error_has_code THEN jsonb_build_object('code',f.error_code) ELSE '{}'::jsonb END) ||
	 (CASE WHEN f.error_has_message THEN jsonb_build_object('message',f.error_message) ELSE '{}'::jsonb END)
	 ELSE NULL END) ELSE '{}'::jsonb END;
	$$;
	
	CREATE OR REPLACE FUNCTION statarena_app.detail_context(c statarena_app.match_details)
	RETURNS jsonb LANGUAGE sql STABLE AS $$
	 SELECT CASE WHEN c.has_context THEN (jsonb_build_object('competition_id', c."competition_id",
	'competition_name', c."competition_name",
	'country_code', c."country_code",
	'season', c."season",
	'retrieved_at_utc', c."retrieved_at_utc",
	'complete', c."complete",
	'fixture', CASE WHEN 'fixture'=ANY(c.null_groups) THEN NULL ELSE (jsonb_build_object('id', c."fixture_id",
	'date', c."fixture_date",
	'time_utc', c."fixture_time_utc",
	'status', c."fixture_status",
	'score_home', c."fixture_score_home",
	'score_away', c."fixture_score_away",
	'home_team', CASE WHEN 'fixture.home_team'=ANY(c.null_groups) THEN NULL ELSE (jsonb_build_object('id', c."fixture_home_team_id",
	'name', c."fixture_home_team_name",
	'image_url', c."fixture_home_team_image_url") - array_remove(ARRAY[CASE WHEN 'fixture.home_team.id'=ANY(c.missing) THEN 'id' END, CASE WHEN 'fixture.home_team.name'=ANY(c.missing) THEN 'name' END, CASE WHEN 'fixture.home_team.image_url'=ANY(c.missing) THEN 'image_url' END],NULL)) END,
	'away_team', CASE WHEN 'fixture.away_team'=ANY(c.null_groups) THEN NULL ELSE (jsonb_build_object('id', c."fixture_away_team_id",
	'name', c."fixture_away_team_name",
	'image_url', c."fixture_away_team_image_url") - array_remove(ARRAY[CASE WHEN 'fixture.away_team.id'=ANY(c.missing) THEN 'id' END, CASE WHEN 'fixture.away_team.name'=ANY(c.missing) THEN 'name' END, CASE WHEN 'fixture.away_team.image_url'=ANY(c.missing) THEN 'image_url' END],NULL)) END) - array_remove(ARRAY[CASE WHEN 'fixture.id'=ANY(c.missing) THEN 'id' END, CASE WHEN 'fixture.date'=ANY(c.missing) THEN 'date' END, CASE WHEN 'fixture.time_utc'=ANY(c.missing) THEN 'time_utc' END, CASE WHEN 'fixture.status'=ANY(c.missing) THEN 'status' END, CASE WHEN 'fixture.score_home'=ANY(c.missing) THEN 'score_home' END, CASE WHEN 'fixture.score_away'=ANY(c.missing) THEN 'score_away' END, CASE WHEN 'fixture.home_team'=ANY(c.missing) THEN 'home_team' END, CASE WHEN 'fixture.away_team'=ANY(c.missing) THEN 'away_team' END],NULL)) END) - c.missing) ELSE '{}'::jsonb END;
	$$;
	

