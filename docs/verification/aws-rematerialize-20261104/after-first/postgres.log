	CREATE OR REPLACE FUNCTION statarena_app.detail_data_heatmaps(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'grid', CASE WHEN 'grid'=ANY(r.null_groups) THEN NULL ELSE (jsonb_build_object('frame', r."grid_frame",
	'length', r."grid_length",
	'width', r."grid_width",
	'cell_length_m', r."grid_cell_length_m",
	'cell_width_m', r."grid_cell_width_m") - array_remove(ARRAY[CASE WHEN 'grid.frame'=ANY(r.missing) THEN 'frame' END, CASE WHEN 'grid.length'=ANY(r.missing) THEN 'length' END, CASE WHEN 'grid.width'=ANY(r.missing) THEN 'width' END, CASE WHEN 'grid.cell_length_m'=ANY(r.missing) THEN 'cell_length_m' END, CASE WHEN 'grid.cell_width_m'=ANY(r.missing) THEN 'cell_width_m' END],NULL)) END,
	'teams', CASE WHEN 'teams'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('side', r1."side",
	'actions', r1."actions",
	'team', CASE WHEN 'team'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."team_id",
	'name', r1."team_name",
	'image_url', r1."team_image_url") - array_remove(ARRAY[CASE WHEN 'team.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'team.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'team.image_url'=ANY(r1.missing) THEN 'image_url' END],NULL)) END,
	'cells', r1."cells") - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.team_heatmaps r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END,
	'players', CASE WHEN 'players'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('side', r1."side",
	'actions', r1."actions",
	'team', CASE WHEN 'team'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."team_id",
	'name', r1."team_name",
	'image_url', r1."team_image_url") - array_remove(ARRAY[CASE WHEN 'team.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'team.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'team.image_url'=ANY(r1.missing) THEN 'image_url' END],NULL)) END,
	'cells', r1."cells",
	'player', CASE WHEN 'player'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."player_id",
	'name', r1."player_name",
	'image_url', r1."player_image_url",
	'position_id', r1."player_position_id",
	'shirt_number', r1."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r1.missing) THEN 'image_url' END, CASE WHEN 'player.position_id'=ANY(r1.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r1.missing) THEN 'shirt_number' END],NULL)) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.player_heatmaps r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.heatmap_sheets r WHERE r.resource_id=rid;
	$$;
	
