	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.advanced_team_sheets r WHERE r.resource_id=rid;
	$$;
	
	CREATE TABLE IF NOT EXISTS statarena_app.advanced_player_sheets (
	 resource_id bigint NOT NULL REFERENCES statarena_app.match_families ON DELETE CASCADE,
	 record_no integer NOT NULL,
	 missing text[] NOT NULL,
	 null_groups text[] NOT NULL,
	 "match_id" text,
	 "sorted_by" text,
	 PRIMARY KEY(resource_id,record_no),
	 CHECK (record_no=0)
	);
	
