	'periods', CASE WHEN 'periods'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('period', r1."period",
	'groups', CASE WHEN 'groups'=ANY(r1.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('group_name', r2."group_name",
	'items', CASE WHEN 'items'=ANY(r2.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('title', r3."title",
	'key', r3."key",
	'home', r3."home",
	'away', r3."away",
	'format_type', r3."format_type") - r3.missing) ORDER BY r3.position), '[]'::jsonb) FROM statarena_app.team_stat_items r3
	 WHERE r3.resource_id=r2.resource_id AND r3.parent_no=r2.record_no) END) - r2.missing) ORDER BY r2.position), '[]'::jsonb) FROM statarena_app.team_stat_groups r2
	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.team_stat_periods r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.team_stat_sheets r WHERE r.resource_id=rid;
	$$;
	
