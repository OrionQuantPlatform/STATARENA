	'name', c."fixture_home_team_name",
	'image_url', c."fixture_home_team_image_url") - array_remove(ARRAY[CASE WHEN 'fixture.home_team.id'=ANY(c.missing) THEN 'id' END, CASE WHEN 'fixture.home_team.name'=ANY(c.missing) THEN 'name' END, CASE WHEN 'fixture.home_team.image_url'=ANY(c.missing) THEN 'image_url' END],NULL)) END,
	'away_team', CASE WHEN 'fixture.away_team'=ANY(c.null_groups) THEN NULL ELSE (jsonb_build_object('id', c."fixture_away_team_id",
