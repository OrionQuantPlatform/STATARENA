	CREATE OR REPLACE FUNCTION statarena_app.detail_data_pass_networks(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'networks', CASE WHEN 'networks'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('centralization', r1."centralization",
	'team', CASE WHEN 'team'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."team_id",
	'name', r1."team_name",
	'image_url', r1."team_image_url") - array_remove(ARRAY[CASE WHEN 'team.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'team.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'team.image_url'=ANY(r1.missing) THEN 'image_url' END],NULL)) END,
	'window', CASE WHEN 'window'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('kind', r1."window_kind",
	'until_seconds', r1."window_until_seconds") - array_remove(ARRAY[CASE WHEN 'window.kind'=ANY(r1.missing) THEN 'kind' END, CASE WHEN 'window.until_seconds'=ANY(r1.missing) THEN 'until_seconds' END],NULL)) END,
	'nodes', CASE WHEN 'nodes'=ANY(r1.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('avg_x', r2."avg_x",
	'avg_y', r2."avg_y",
	'passes', r2."passes",
	'passes_received', r2."passes_received",
	'degree', r2."degree",
	'strength', r2."strength",
	'betweenness', r2."betweenness",
	'clustering', r2."clustering",
	'player', CASE WHEN 'player'=ANY(r2.null_groups) THEN NULL ELSE (jsonb_build_object('id', r2."player_id",
	'name', r2."player_name",
	'image_url', r2."player_image_url",
	'position_id', r2."player_position_id",
	'shirt_number', r2."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r2.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r2.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r2.missing) THEN 'image_url' END, CASE WHEN 'player.position_id'=ANY(r2.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r2.missing) THEN 'shirt_number' END],NULL)) END) - r2.missing) ORDER BY r2.position), '[]'::jsonb) FROM statarena_app.pass_nodes r2
	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END,
	'edges', CASE WHEN 'edges'=ANY(r1.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('from', CASE WHEN 'from'=ANY(r2.null_groups) THEN NULL ELSE (jsonb_build_object('id', r2."from_id",
	'name', r2."from_name",
	'image_url', r2."from_image_url",
	'position_id', r2."from_position_id",
	'shirt_number', r2."from_shirt_number") - array_remove(ARRAY[CASE WHEN 'from.id'=ANY(r2.missing) THEN 'id' END, CASE WHEN 'from.name'=ANY(r2.missing) THEN 'name' END, CASE WHEN 'from.image_url'=ANY(r2.missing) THEN 'image_url' END, CASE WHEN 'from.position_id'=ANY(r2.missing) THEN 'position_id' END, CASE WHEN 'from.shirt_number'=ANY(r2.missing) THEN 'shirt_number' END],NULL)) END,
	'to', CASE WHEN 'to'=ANY(r2.null_groups) THEN NULL ELSE (jsonb_build_object('id', r2."to_id",
	'name', r2."to_name",
	'image_url', r2."to_image_url",
	'position_id', r2."to_position_id",
	'shirt_number', r2."to_shirt_number") - array_remove(ARRAY[CASE WHEN 'to.id'=ANY(r2.missing) THEN 'id' END, CASE WHEN 'to.name'=ANY(r2.missing) THEN 'name' END, CASE WHEN 'to.image_url'=ANY(r2.missing) THEN 'image_url' END, CASE WHEN 'to.position_id'=ANY(r2.missing) THEN 'position_id' END, CASE WHEN 'to.shirt_number'=ANY(r2.missing) THEN 'shirt_number' END],NULL)) END,
	'passes', r2."passes") - r2.missing) ORDER BY r2.position), '[]'::jsonb) FROM statarena_app.pass_edges r2
	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.pass_networks r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.network_sheets r WHERE r.resource_id=rid;
	$$;
	
