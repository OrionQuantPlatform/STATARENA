	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END,
	'subs', CASE WHEN 'home.subs'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('player_id', r1."player_id",
