	CREATE OR REPLACE FUNCTION statarena_app.detail_data_momentum(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'points', CASE WHEN 'points'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('minute', r1."minute",
	'value', r1."value") - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.momentum_points r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.momentum_sheets r WHERE r.resource_id=rid;
	$$;
	
	CREATE TABLE IF NOT EXISTS statarena_app.h2h_sheets (
	 resource_id bigint NOT NULL REFERENCES statarena_app.match_families ON DELETE CASCADE,
