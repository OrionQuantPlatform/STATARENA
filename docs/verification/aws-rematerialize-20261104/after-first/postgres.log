	'keeper', CASE WHEN 'keeper'=ANY(r2.null_groups) THEN NULL ELSE (jsonb_build_object('id', r2."keeper_id",
	'name', r2."keeper_name",
	'image_url', r2."keeper_image_url",
	'position_id', r2."keeper_position_id",
	'shirt_number', r2."keeper_shirt_number") - array_remove(ARRAY[CASE WHEN 'keeper.id'=ANY(r2.missing) THEN 'id' END, CASE WHEN 'keeper.name'=ANY(r2.missing) THEN 'name' END, CASE WHEN 'keeper.image_url'=ANY(r2.missing) THEN 'image_url' END, CASE WHEN 'keeper.position_id'=ANY(r2.missing) THEN 'position_id' END, CASE WHEN 'keeper.shirt_number'=ANY(r2.missing) THEN 'shirt_number' END],NULL)) END) - r2.missing) ORDER BY r2.position), '[]'::jsonb) FROM statarena_app.match_shots r2
	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.shot_periods r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.shot_sheets r WHERE r.resource_id=rid;
	$$;
	
