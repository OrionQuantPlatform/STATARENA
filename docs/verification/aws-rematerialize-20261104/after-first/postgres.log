	CREATE OR REPLACE FUNCTION statarena_app.detail_data_advanced_players(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'sorted_by', r."sorted_by",
	'players', CASE WHEN 'players'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('actions', r1."actions",
	'possession_value', CASE WHEN 'possession_value'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('xt_total', r1."possession_value_xt_total",
	'vaep_total', r1."possession_value_vaep_total",
	'vaep_offensive', r1."possession_value_vaep_offensive",
	'vaep_defensive', r1."possession_value_vaep_defensive",
	'pv_total', r1."possession_value_pv_total",
	'pv_offensive', r1."possession_value_pv_offensive",
	'pv_defensive', r1."possession_value_pv_defensive") - array_remove(ARRAY[CASE WHEN 'possession_value.xt_total'=ANY(r1.missing) THEN 'xt_total' END, CASE WHEN 'possession_value.vaep_total'=ANY(r1.missing) THEN 'vaep_total' END, CASE WHEN 'possession_value.vaep_offensive'=ANY(r1.missing) THEN 'vaep_offensive' END, CASE WHEN 'possession_value.vaep_defensive'=ANY(r1.missing) THEN 'vaep_defensive' END, CASE WHEN 'possession_value.pv_total'=ANY(r1.missing) THEN 'pv_total' END, CASE WHEN 'possession_value.pv_offensive'=ANY(r1.missing) THEN 'pv_offensive' END, CASE WHEN 'possession_value.pv_defensive'=ANY(r1.missing) THEN 'pv_defensive' END],NULL)) END,
	'passing', CASE WHEN 'passing'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('passes', r1."passing_passes",
	'pass_accuracy', r1."passing_pass_accuracy",
	'progressive_passes', r1."passing_progressive_passes",
	'progressive_pass_distance', r1."passing_progressive_pass_distance",
	'passes_into_box', r1."passing_passes_into_box",
	'key_passes', r1."passing_key_passes",
	'assists', r1."passing_assists",
	'through_balls', r1."passing_through_balls",
	'crosses', r1."passing_crosses",
	'switches', r1."passing_switches") - array_remove(ARRAY[CASE WHEN 'passing.passes'=ANY(r1.missing) THEN 'passes' END, CASE WHEN 'passing.pass_accuracy'=ANY(r1.missing) THEN 'pass_accuracy' END, CASE WHEN 'passing.progressive_passes'=ANY(r1.missing) THEN 'progressive_passes' END, CASE WHEN 'passing.progressive_pass_distance'=ANY(r1.missing) THEN 'progressive_pass_distance' END, CASE WHEN 'passing.passes_into_box'=ANY(r1.missing) THEN 'passes_into_box' END, CASE WHEN 'passing.key_passes'=ANY(r1.missing) THEN 'key_passes' END, CASE WHEN 'passing.assists'=ANY(r1.missing) THEN 'assists' END, CASE WHEN 'passing.through_balls'=ANY(r1.missing) THEN 'through_balls' END, CASE WHEN 'passing.crosses'=ANY(r1.missing) THEN 'crosses' END, CASE WHEN 'passing.switches'=ANY(r1.missing) THEN 'switches' END],NULL)) END,
	'carrying', CASE WHEN 'carrying'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('carries', r1."carrying_carries",
	'carry_distance', r1."carrying_carry_distance",
	'progressive_carries', r1."carrying_progressive_carries",
	'progressive_carry_distance', r1."carrying_progressive_carry_distance",
	'carries_into_final_third', r1."carrying_carries_into_final_third",
	'carries_into_box', r1."carrying_carries_into_box",
	'take_ons', r1."carrying_take_ons",
	'take_ons_won', r1."carrying_take_ons_won",
	'miscontrols', r1."carrying_miscontrols",
	'dispossessed', r1."carrying_dispossessed") - array_remove(ARRAY[CASE WHEN 'carrying.carries'=ANY(r1.missing) THEN 'carries' END, CASE WHEN 'carrying.carry_distance'=ANY(r1.missing) THEN 'carry_distance' END, CASE WHEN 'carrying.progressive_carries'=ANY(r1.missing) THEN 'progressive_carries' END, CASE WHEN 'carrying.progressive_carry_distance'=ANY(r1.missing) THEN 'progressive_carry_distance' END, CASE WHEN 'carrying.carries_into_final_third'=ANY(r1.missing) THEN 'carries_into_final_third' END, CASE WHEN 'carrying.carries_into_box'=ANY(r1.missing) THEN 'carries_into_box' END, CASE WHEN 'carrying.take_ons'=ANY(r1.missing) THEN 'take_ons' END, CASE WHEN 'carrying.take_ons_won'=ANY(r1.missing) THEN 'take_ons_won' END, CASE WHEN 'carrying.miscontrols'=ANY(r1.missing) THEN 'miscontrols' END, CASE WHEN 'carrying.dispossessed'=ANY(r1.missing) THEN 'dispossessed' END],NULL)) END,
	'creation', CASE WHEN 'creation'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('sca', r1."creation_sca",
	'gca', r1."creation_gca",
	'chances_created', r1."creation_chances_created",
	'second_assists', r1."creation_second_assists",
	'xag', r1."creation_xag",
	'xg_chain', r1."creation_xg_chain",
	'xg_buildup', r1."creation_xg_buildup",
	'sca_breakdown', CASE WHEN 'creation.sca_breakdown'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('pass_live', r1."creation_sca_breakdown_pass_live",
	'pass_dead', r1."creation_sca_breakdown_pass_dead",
	'take_on', r1."creation_sca_breakdown_take_on",
	'shot', r1."creation_sca_breakdown_shot",
	'foul_drawn', r1."creation_sca_breakdown_foul_drawn",
	'defensive', r1."creation_sca_breakdown_defensive") - array_remove(ARRAY[CASE WHEN 'creation.sca_breakdown.pass_live'=ANY(r1.missing) THEN 'pass_live' END, CASE WHEN 'creation.sca_breakdown.pass_dead'=ANY(r1.missing) THEN 'pass_dead' END, CASE WHEN 'creation.sca_breakdown.take_on'=ANY(r1.missing) THEN 'take_on' END, CASE WHEN 'creation.sca_breakdown.shot'=ANY(r1.missing) THEN 'shot' END, CASE WHEN 'creation.sca_breakdown.foul_drawn'=ANY(r1.missing) THEN 'foul_drawn' END, CASE WHEN 'creation.sca_breakdown.defensive'=ANY(r1.missing) THEN 'defensive' END],NULL)) END) - array_remove(ARRAY[CASE WHEN 'creation.sca'=ANY(r1.missing) THEN 'sca' END, CASE WHEN 'creation.gca'=ANY(r1.missing) THEN 'gca' END, CASE WHEN 'creation.chances_created'=ANY(r1.missing) THEN 'chances_created' END, CASE WHEN 'creation.second_assists'=ANY(r1.missing) THEN 'second_assists' END, CASE WHEN 'creation.xag'=ANY(r1.missing) THEN 'xag' END, CASE WHEN 'creation.xg_chain'=ANY(r1.missing) THEN 'xg_chain' END, CASE WHEN 'creation.xg_buildup'=ANY(r1.missing) THEN 'xg_buildup' END, CASE WHEN 'creation.sca_breakdown'=ANY(r1.missing) THEN 'sca_breakdown' END],NULL)) END,
	'defending', CASE WHEN 'defending'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('tackles', r1."defending_tackles",
	'interceptions', r1."defending_interceptions",
	'blocks', r1."defending_blocks",
	'clearances', r1."defending_clearances",
	'duels_won', r1."defending_duels_won",
	'aerials', r1."defending_aerials",
	'aerials_won', r1."defending_aerials_won",
	'ppda', r1."defending_ppda",
	'opponent_passes', r1."defending_opponent_passes",
	'defensive_actions', r1."defending_defensive_actions",
	'challenges', r1."defending_challenges",
	'avg_defensive_action_x', r1."defending_avg_defensive_action_x",
	'high_turnovers', r1."defending_high_turnovers",
	'counterpress_regains_5s', r1."defending_counterpress_regains_5s",
	'ball_recovery_time', r1."defending_ball_recovery_time") - array_remove(ARRAY[CASE WHEN 'defending.tackles'=ANY(r1.missing) THEN 'tackles' END, CASE WHEN 'defending.interceptions'=ANY(r1.missing) THEN 'interceptions' END, CASE WHEN 'defending.blocks'=ANY(r1.missing) THEN 'blocks' END, CASE WHEN 'defending.clearances'=ANY(r1.missing) THEN 'clearances' END, CASE WHEN 'defending.duels_won'=ANY(r1.missing) THEN 'duels_won' END, CASE WHEN 'defending.aerials'=ANY(r1.missing) THEN 'aerials' END, CASE WHEN 'defending.aerials_won'=ANY(r1.missing) THEN 'aerials_won' END, CASE WHEN 'defending.ppda'=ANY(r1.missing) THEN 'ppda' END, CASE WHEN 'defending.opponent_passes'=ANY(r1.missing) THEN 'opponent_passes' END, CASE WHEN 'defending.defensive_actions'=ANY(r1.missing) THEN 'defensive_actions' END, CASE WHEN 'defending.challenges'=ANY(r1.missing) THEN 'challenges' END, CASE WHEN 'defending.avg_defensive_action_x'=ANY(r1.missing) THEN 'avg_defensive_action_x' END, CASE WHEN 'defending.high_turnovers'=ANY(r1.missing) THEN 'high_turnovers' END, CASE WHEN 'defending.counterpress_regains_5s'=ANY(r1.missing) THEN 'counterpress_regains_5s' END, CASE WHEN 'defending.ball_recovery_time'=ANY(r1.missing) THEN 'ball_recovery_time' END],NULL)) END,
	'team_id', r1."team_id",
	'player', CASE WHEN 'player'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."player_id",
	'name', r1."player_name",
	'image_url', r1."player_image_url",
	'position_id', r1."player_position_id",
	'shirt_number', r1."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r1.missing) THEN 'image_url' END, CASE WHEN 'player.position_id
'=ANY(r1.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r1.missing) THEN 'shirt_number' END],NULL)) END,
	'minutes_played', r1."minutes_played",
	'goalkeeping', CASE WHEN 'goalkeeping'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('claims', r1."goalkeeping_claims",
	'claims_won', r1."goalkeeping_claims_won",
	'claim_rate', r1."goalkeeping_claim_rate",
	'sweeper_actions', r1."goalkeeping_sweeper_actions",
	'distributions', r1."goalkeeping_distributions",
	'launches', r1."goalkeeping_launches",
	'launch_pct', r1."goalkeeping_launch_pct",
	'avg_pass_length', r1."goalkeeping_avg_pass_length",
	'distribution_accuracy', r1."goalkeeping_distribution_accuracy") - array_remove(ARRAY[CASE WHEN 'goalkeeping.claims'=ANY(r1.missing) THEN 'claims' END, CASE WHEN 'goalkeeping.claims_won'=ANY(r1.missing) THEN 'claims_won' END, CASE WHEN 'goalkeeping.claim_rate'=ANY(r1.missing) THEN 'claim_rate' END, CASE WHEN 'goalkeeping.sweeper_actions'=ANY(r1.missing) THEN 'sweeper_actions' END, CASE WHEN 'goalkeeping.distributions'=ANY(r1.missing) THEN 'distributions' END, CASE WHEN 'goalkeeping.launches'=ANY(r1.missing) THEN 'launches' END, CASE WHEN 'goalkeeping.launch_pct'=ANY(r1.missing) THEN 'launch_pct' END, CASE WHEN 'goalkeeping.avg_pass_length'=ANY(r1.missing) THEN 'avg_pass_length' END, CASE WHEN 'goalkeeping.distribution_accuracy'=ANY(r1.missing) THEN 'distribution_accuracy' END],NULL)) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.advanced_player_totals r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.advanced_player_sheets r WHERE r.resource_id=rid;
	$$;
	
