	CREATE OR REPLACE FUNCTION statarena_app.detail_data_player_shots(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('player', CASE WHEN 'player'=ANY(r.null_groups) THEN NULL ELSE (jsonb_build_object('id', r."player_id",
	'name', r."player_name",
