	CREATE OR REPLACE FUNCTION statarena_app.detail_data_advanced_teams(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'teams', CASE WHEN 'teams'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('actions', r1."actions",
	'possession_value', CASE WHEN 'possession_value'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('xt_total', r1."possession_value_xt_total",
	'vaep_total', r1."possession_value_vaep_total",
