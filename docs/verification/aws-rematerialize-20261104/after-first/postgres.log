	CREATE OR REPLACE FUNCTION statarena_app.detail_response(f statarena_app.match_families)
	RETURNS jsonb LANGUAGE sql STABLE AS $$
	 SELECT jsonb_build_object('status', f.status)
	 || CASE WHEN f.has_data THEN jsonb_build_object('data', CASE f.family
	WHEN 'match' THEN statarena_app.detail_data_match(f.resource_id)
	WHEN 'events' THEN statarena_app.detail_data_events(f.resource_id)
	WHEN 'shots' THEN statarena_app.detail_data_shots(f.resource_id)
	WHEN 'stats' THEN statarena_app.detail_data_stats(f.resource_id)
	WHEN 'lineups' THEN statarena_app.detail_data_lineups(f.resource_id)
	WHEN 'players' THEN statarena_app.detail_data_players(f.resource_id)
	WHEN 'player_halves' THEN statarena_app.detail_data_player_halves(f.resource_id)
	WHEN 'momentum' THEN statarena_app.detail_data_momentum(f.resource_id)
	WHEN 'h2h' THEN statarena_app.detail_data_h2h(f.resource_id)
	WHEN 'advanced_teams' THEN statarena_app.detail_data_advanced_teams(f.resource_id)
	WHEN 'advanced_players' THEN statarena_app.detail_data_advanced_players(f.resource_id)
	WHEN 'pass_networks' THEN statarena_app.detail_data_pass_networks(f.resource_id)
	WHEN 'heatmaps' THEN statarena_app.detail_data_heatmaps(f.resource_id)
	WHEN 'player_shots' THEN statarena_app.detail_data_player_shots(f.resource_id)
	WHEN 'single_shot' THEN statarena_app.detail_data_shots(f.resource_id) #> '{periods,0,shots,0}'
	WHEN 'single_player' THEN statarena_app.detail_data_players(f.resource_id) -> 0
	WHEN 'single_halves' THEN (SELECT (payload #> '{players,0}') || (payload-'players') FROM statarena_app.detail_data_player_halves(f.resource_id) payload)
	WHEN 'single_advanced' THEN statarena_app.detail_data_advanced_players(f.resource_id) #> '{players,0}'
	END) ELSE '{}'::jsonb END
	 || CASE WHEN f.has_error THEN jsonb_build_object('error', CASE WHEN f.error_object THEN
	 (CASE WHEN f.error_has_code THEN jsonb_build_object('code',f.error_code) ELSE '{}'::jsonb END) ||
	 (CASE WHEN f.error_has_message THEN jsonb_build_object('message',f.error_message) ELSE '{}'::jsonb END)
	 ELSE NULL END) ELSE '{}'::jsonb END;
	$$;
	
