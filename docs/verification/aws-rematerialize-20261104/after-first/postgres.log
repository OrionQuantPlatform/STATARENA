	CREATE OR REPLACE FUNCTION statarena_app.detail_data_players(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('players', CASE WHEN 'players'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('team_id', r1."team_id",
	'player', CASE WHEN 'player'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."player_id",
	'name', r1."player_name",
	'image_url', r1."player_image_url",
	'position_id', r1."player_position_id",
	'shirt_number', r1."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r1.missing) THEN 'image_url' END, CASE WHEN 'player.position_id'=ANY(r1.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r1.missing) THEN 'shirt_number' END],NULL)) END,
	'stats', CASE WHEN 'stats'=ANY(r1.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('key', r2."key",
	'title', r2."title",
	'stats', CASE WHEN 'stats'=ANY(r2.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_object_agg(r3.metric_label, (jsonb_build_object('key', r3."key",
	'stat', CASE WHEN 'stat'=ANY(r3.null_groups) THEN NULL ELSE (jsonb_build_object('type', r3."stat_type",
	'value', r3."stat_value",
	'total', r3."stat_total") - array_remove(ARRAY[CASE WHEN 'stat.type'=ANY(r3.missing) THEN 'type' END, CASE WHEN 'stat.value'=ANY(r3.missing) THEN 'value' END, CASE WHEN 'stat.total'=ANY(r3.missing) THEN 'total' END],NULL)) END) - r3.missing)), '{}'::jsonb) FROM statarena_app.player_stat_metrics r3
	 WHERE r3.resource_id=r2.resource_id AND r3.parent_no=r2.record_no) END) - r2.missing) ORDER BY r2.position), '[]'::jsonb) FROM statarena_app.player_stat_groups r2
	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.match_players r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) -> 'players' FROM statarena_app.player_sheets r WHERE r.resource_id=rid;
	$$;
	
