	'position_id', r2."player_position_id",
	'shirt_number', r2."player_shirt_number") - array_remove(ARRAY[CASE WHEN 'player.id'=ANY(r2.missing) THEN 'id' END, CASE WHEN 'player.name'=ANY(r2.missing) THEN 'name' END, CASE WHEN 'player.image_url'=ANY(r2.missing) THEN 'image_url' END, CASE WHEN 'player.position_id'=ANY(r2.missing) THEN 'position_id' END, CASE WHEN 'player.shirt_number'=ANY(r2.missing) THEN 'shirt_number' END],NULL)) END,
	'keeper', CASE WHEN 'keeper'=ANY(r2.null_groups) THEN NULL ELSE (jsonb_build_object('id', r2."keeper_id",
