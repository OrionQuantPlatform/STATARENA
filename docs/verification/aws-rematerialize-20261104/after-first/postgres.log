	 WHERE r2.resource_id=r1.resource_id AND r2.parent_no=r1.record_no) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.shot_periods r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.shot_sheets r WHERE r.resource_id=rid;
