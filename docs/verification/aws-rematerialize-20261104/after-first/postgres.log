	);
	
	CREATE OR REPLACE FUNCTION statarena_app.detail_data_h2h(rid bigint) RETURNS jsonb LANGUAGE sql STABLE AS $$
	SELECT (jsonb_build_object('match_id', r."match_id",
	'home_team', CASE WHEN 'home_team'=ANY(r.null_groups) THEN NULL ELSE (jsonb_build_object('id', r."home_team_id",
	'name', r."home_team_name",
	'image_url', r."home_team_image_url") - array_remove(ARRAY[CASE WHEN 'home_team.id'=ANY(r.missing) THEN 'id' END, CASE WHEN 'home_team.name'=ANY(r.missing) THEN 'name' END, CASE WHEN 'home_team.image_url'=ANY(r.missing) THEN 'image_url' END],NULL)) END,
	'away_team', CASE WHEN 'away_team'=ANY(r.null_groups) THEN NULL ELSE (jsonb_build_object('id', r."away_team_id",
	'name', r."away_team_name",
	'image_url', r."away_team_image_url") - array_remove(ARRAY[CASE WHEN 'away_team.id'=ANY(r.missing) THEN 'id' END, CASE WHEN 'away_team.name'=ANY(r.missing) THEN 'name' END, CASE WHEN 'away_team.image_url'=ANY(r.missing) THEN 'image_url' END],NULL)) END,
	'home_wins', r."home_wins",
	'draws', r."draws",
	'away_wins', r."away_wins",
	'total_matches', r."total_matches",
	'recent_matches', CASE WHEN 'recent_matches'=ANY(r.null_groups) THEN NULL ELSE (SELECT coalesce(jsonb_agg((jsonb_build_object('time_utc', r1."time_utc",
	'score_home', r1."score_home",
	'score_away', r1."score_away",
	'finished', r1."finished",
	'home', CASE WHEN 'home'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."home_id",
	'name', r1."home_name",
	'image_url', r1."home_image_url") - array_remove(ARRAY[CASE WHEN 'home.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'home.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'home.image_url'=ANY(r1.missing) THEN 'image_url' END],NULL)) END,
	'away', CASE WHEN 'away'=ANY(r1.null_groups) THEN NULL ELSE (jsonb_build_object('id', r1."away_id",
	'name', r1."away_name",
	'image_url', r1."away_image_url") - array_remove(ARRAY[CASE WHEN 'away.id'=ANY(r1.missing) THEN 'id' END, CASE WHEN 'away.name'=ANY(r1.missing) THEN 'name' END, CASE WHEN 'away.image_url'=ANY(r1.missing) THEN 'image_url' END],NULL)) END) - r1.missing) ORDER BY r1.position), '[]'::jsonb) FROM statarena_app.h2h_matches r1
	 WHERE r1.resource_id=r.resource_id AND r1.parent_no=r.record_no) END) - r.missing) FROM statarena_app.h2h_sheets r WHERE r.resource_id=rid;
	$$;
	
