	 "team_name" text,
	 "team_image_url" text,
	 "window_kind" text,
	 "window_until_seconds" integer,
	 PRIMARY KEY(resource_id,record_no),
	 FOREIGN KEY(resource_id,parent_no) REFERENCES statarena_app.network_sheets(resource_id,record_no) ON DELETE CASCADE,
