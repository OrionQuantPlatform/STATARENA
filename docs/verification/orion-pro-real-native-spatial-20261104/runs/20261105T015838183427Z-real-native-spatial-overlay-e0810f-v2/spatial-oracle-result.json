  "sql": {
    "parents": "SELECT h.id,r.locator,d.legacy_object_path,d.storage_provider,d.storage_bucket,d.storage_key,d.content_sha256,t.public_key,p.public_key,s.side,h.grid_columns,h.grid_rows,h.cell_length_m,h.cell_width_m,h.coordinate_frame,h.actions,h.cells_state,h.source_id,h.source_record_id,h.match_team_revision_id FROM football.match_heatmaps h JOIN ingest.source_records r ON r.id=h.source_record_id JOIN ingest.source_documents d ON d.id=r.document_id JOIN ingest.public_aliases_current t ON t.route_kind='team' AND t.team_id=h.team_id LEFT JOIN ingest.public_aliases_current p ON p.route_kind='player' AND p.player_id=h.player_id JOIN football.match_teams s ON s.revision_id=h.match_team_revision_id WHERE h.is_canonical AND h.recorded_to_gen IS NULL ORDER BY r.locator",
    "cells": "SELECT cell_ordinal,column_index,row_index,action_count FROM football.match_heatmap_cells WHERE heatmap_id=%s ORDER BY cell_ordinal",
    "slots": "SELECT c.feature_code,c.collection_state,c.observed_row_count,r.locator,d.legacy_object_path FROM ingest.match_coverage c JOIN ingest.source_records r ON r.id=c.source_record_id JOIN ingest.source_documents d ON d.id=r.document_id WHERE c.is_canonical AND c.recorded_to_gen IS NULL AND c.feature_code LIKE 'heatmaps.%%' ORDER BY c.feature_code",
    "sourceRecords": "SELECT r.locator,r.source_id,d.source_id,d.legacy_object_path FROM ingest.source_records r JOIN ingest.source_documents d ON d.id=r.document_id WHERE d.legacy_object_path=%s ORDER BY r.locator"
