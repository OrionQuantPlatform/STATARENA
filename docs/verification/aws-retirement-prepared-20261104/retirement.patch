diff --git a/dashboard/scripts/staging/aws.mjs b/dashboard/scripts/staging/aws.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..fb3a6496c3625e2f04702774af7b3825f8a40fe6
--- /dev/null
+++ b/dashboard/scripts/staging/aws.mjs
@@ -0,0 +1,217 @@
+// Worker-only staging client. Public HTTP routes must use backend/services/postgres.js.
+import pg from "pg";
+import { S3Client, GetObjectCommand } from "@aws-sdk/client-s3";
+import { createHash } from "node:crypto";
+import { gunzipSync } from "node:zlib";
+import { readFileSync } from "node:fs";
+import { databaseConnectionOptions } from "../../backend/services/database-connection.js";
+import { cache } from "../../backend/services/cache.js";
+const local = (url) =>
+  process.env.STATARENA_INGEST_TEST === "1" &&
+  ["127.0.0.1", "localhost", "[::1]"].includes(url.hostname);
+const jsonCache = cache(64 * 1024 * 1024, {
+  name: "staging_json",
+  maxEntryBytes: 8 * 1024 * 1024,
+});
+let pool, storage;
+const required = (key) => {
+  const v = process.env[key];
+  if (!v) throw Error("Missing worker configuration: " + key);
+  return v;
+};
+export const canonical = (params = {}) =>
+  JSON.stringify(
+    Object.fromEntries(
+      Object.entries(params).sort(([a], [b]) => a.localeCompare(b)),
+    ),
+  );
+export function database() {
+  if (pool) return pool;
+  const u = new URL(required("INGEST_DATABASE_URL"));
+  if (
+    !["postgres:", "postgresql:"].includes(u.protocol) ||
+    (!local(u) &&
+      (!u.hostname.endsWith(".us-east-2.rds.amazonaws.com") ||
+        u.pathname !== "/statarena_prod"))
+  )
+    throw Error("Unexpected worker database endpoint");
+  let options;
+  if (local(u) && u.searchParams.get("sslmode") === "disable") {
+    u.searchParams.delete("sslmode");
+    options = { connectionString: u.href, ssl: false };
+  } else
+    options = databaseConnectionOptions(
+      u.href,
+      process.env.DATABASE_CA_PEM ||
+        readFileSync(
+          new URL("../../backend/certs/rds-us-east-2.pem", import.meta.url),
+          "utf8",
+        ),
+    );
+  pool = new pg.Pool({
+    ...options,
+    max: 3,
+    application_name: "statarena-staging-worker",
+    connectionTimeoutMillis: 10000,
+    idleTimeoutMillis: 10000,
+    maxLifetimeSeconds: 300,
+    query_timeout: 30000,
+    allowExitOnIdle: true,
+  });
+  pool.on("error", (e) =>
+    console.error("Staging database connection error", e.code || e.name),
+  );
+  return pool;
+}
+export async function query(sql, bindings = []) {
+  return (await database().query(sql, bindings)).rows;
+}
+function objects() {
+  if (storage) return storage;
+  const region = required("INGEST_S3_REGION"),
+    bucket = required("INGEST_S3_BUCKET"),
+    override = process.env.INGEST_S3_ENDPOINT;
+  if (region !== "us-east-2") throw Error("Invalid worker storage region");
+  const localDatabase = local(new URL(required("INGEST_DATABASE_URL")));
+  if (localDatabase && !override)
+    throw Error("Loopback worker tests require an isolated storage endpoint");
+  if (override) {
+    const u = new URL(override);
+    if (
+      !localDatabase ||
+      !local(u) ||
+      u.protocol !== "http:" ||
+      u.username ||
+      u.password ||
+      u.pathname !== "/" ||
+      u.search ||
+      u.hash
+    )
+      throw Error("Invalid worker storage endpoint");
+  }
+  if (!override && bucket !== "statarena-football-333rosky-70db6e5f")
+    throw Error("Unexpected worker storage bucket");
+  const client = new S3Client({
+    region,
+    endpoint: override,
+    forcePathStyle: Boolean(override),
+    credentials: {
+      accessKeyId: required("INGEST_S3_ACCESS_KEY_ID"),
+      secretAccessKey: required("INGEST_S3_SECRET_ACCESS_KEY"),
+    },
+    requestChecksumCalculation: "WHEN_REQUIRED",
+    responseChecksumValidation: "WHEN_REQUIRED",
+    maxAttempts: 3,
+  });
+  storage = { client, bucket };
+  return storage;
+}
+async function bytes(path) {
+  const { client, bucket } = objects();
+  const result = await client.send(
+    new GetObjectCommand({ Bucket: bucket, Key: "data/" + path }),
+    { abortSignal: AbortSignal.timeout(20000) },
+  );
+  return Buffer.from(await result.Body.transformToByteArray());
+}
+function valid(body, meta) {
+  return (
+    body &&
+    body.byteLength === Number(meta.size) &&
+    createHash("sha256").update(body).digest("hex") === meta.sha256
+  );
+}
+async function readVersion(path, meta) {
+  const mutable =
+    path === "raw/index.json" ||
+    path === "computed/dashboard/index.json" ||
+    path.startsWith("computed/matchdays/");
+  let body;
+  try {
+    body = await bytes(path);
+  } catch (e) {
+    if (!mutable || e.$metadata?.httpStatusCode !== 404) throw e;
+  }
+  if (!valid(body, meta) && mutable) {
+    // This is an existing persisted object-key namespace written by the migration.
+    body = await bytes(
+      "raw/neon/versions/" +
+        meta.sha256 +
+        (path.endsWith(".gz") ? ".json.gz" : ".json"),
+    );
+  }
+  if (!valid(body, meta)) throw Error("Staging object integrity mismatch");
+  return JSON.parse(
+    (path.endsWith(".gz")
+      ? gunzipSync(body, { maxOutputLength: 128 * 1024 * 1024 })
+      : body
+    ).toString("utf8"),
+  );
+}
+export async function dataJson(path) {
+  if (
+    !/^(?:raw|computed|sources)\/[A-Za-z0-9_./-]+\.json(?:\.gz)?$/.test(path) ||
+    path.split("/").some((p) => !p || p.startsWith("."))
+  )
+    throw Error("Invalid staging data path");
+  const sql =
+    "SELECT size,encode(sha256,'hex') AS sha256 FROM statarena.objects WHERE path=$1";
+  const [meta] = await query(sql, [path]);
+  if (!meta) {
+    const e = Error("Missing staging object");
+    e.code = "ENOENT";
+    throw e;
+  }
+  try {
+    return await jsonCache(
+      path + ":" + meta.sha256,
+      () => readVersion(path, meta),
+      15 * 60000,
+    );
+  } catch (e) {
+    const [latest] = await query(sql, [path]);
+    if (!latest || latest.sha256 === meta.sha256) throw e;
+    return jsonCache(
+      path + ":" + latest.sha256,
+      () => readVersion(path, latest),
+      15 * 60000,
+    );
+  }
+}
+export async function savedResource(endpoint, params = {}) {
+  const [row] = await query(
+    "SELECT status,ref,error FROM statarena.resources WHERE endpoint=$1 AND params=$2",
+    [endpoint, canonical(params)],
+  );
+  if (!row) return null;
+  if (!row.ref) return { status: row.status, error: row.error };
+  let item = await dataJson(row.ref.path);
+  if (row.ref.ordinal !== undefined) item = item[row.ref.ordinal];
+  if (row.ref.documentId)
+    item = item.find((v) => v.documentId === row.ref.documentId);
+  if (!item) throw Error("Incomplete staging resource reference");
+  const observed = item.observation || item;
+  const value = observed.response || observed;
+  return {
+    status: row.status,
+    data: value.data ?? null,
+    error: row.error || value.error || null,
+  };
+}
+// Only the observed-coaches worker consumes a shard family directly.
+export async function archivedResource(endpoint) {
+  const m = /^\/matches\/(m_[A-Za-z0-9]{6})\/lineups$/.exec(endpoint);
+  if (!m) return null;
+  const [row] = await query(
+    "SELECT o.ordinal,s.ref FROM statarena.observations o JOIN statarena.shards s ON s.id=o.shard WHERE o.id=$1",
+    [m[1]],
+  );
+  if (!row?.ref.tables?.lineups) return null;
+  const [docs, rows] = await Promise.all([
+    dataJson(row.ref.document.path),
+    dataJson(row.ref.tables.lineups.path),
+  ]);
+  const doc = docs[row.ordinal];
+  if (!doc) throw Error("Incomplete staging shard reference");
+  return rows.find((r) => r.documentId === doc.id)?.response || null;
+}
