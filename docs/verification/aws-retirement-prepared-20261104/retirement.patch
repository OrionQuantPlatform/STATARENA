+"""Exercise the actual Python staging Store with the same disposable worker-only AWS configuration."""
+import json,sys,os
+from pathlib import Path
+sys.path.insert(0,str(Path(__file__).resolve().parents[3]/"dashboard/scripts"))
+from neon_store import Store
+s=Store()
+try:
+ path="raw/worker-proof.json"
+ assert s.put_json(path,{"n":0,"source":"private-fixture"})
+ assert s.json(path)=={"n":0,"source":"private-fixture"}
+ version=s.db.execute("select xmin::text from statarena.objects where path=%s",(path,)).fetchone()
+ s.put_json(path,{"n":0,"source":"private-fixture"})
+ assert version==s.db.execute("select xmin::text from statarena.objects where path=%s",(path,)).fetchone()
+ print(json.dumps({"pythonStore":"wrote, SHA-verified, unchanged repeat","path":path}))
+finally:s.db.close()
diff --git a/docs/verification/aws-legacy-retirement-20261104/verify.mjs b/docs/verification/aws-legacy-retirement-20261104/verify.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..710ec0ff8df45458cff309e8305e4e5ec2855baa
--- /dev/null
+++ b/docs/verification/aws-legacy-retirement-20261104/verify.mjs
@@ -0,0 +1,498 @@
+import assert from "node:assert/strict";
+import { execFile, execFileSync } from "node:child_process";
+import { promisify } from "node:util";
+const execAsync = promisify(execFile);
+import { mkdtemp, readFile, rm, writeFile, mkdir } from "node:fs/promises";
+import { createHash } from "node:crypto";
+import { gzipSync } from "node:zlib";
+import { createRequire } from "node:module";
+import { tmpdir } from "node:os";
+import path from "node:path";
+const stage = process.argv[2];
+assert.ok(["before", "after"].includes(stage));
+const cwd = path.resolve(import.meta.dir, "../../.."),
+  req = createRequire(cwd + "/dashboard/package.json"),
+  { Client } = req("pg"),
+  { S3Client, PutObjectCommand, CreateBucketCommand } =
+    req("@aws-sdk/client-s3");
+const { default: PG } = await import(
+  (process.env.STATARENA_TEST_TOOLS || "/tmp/statarena-archive-remat-pg") +
+    "/node_modules/embedded-postgres/dist/index.js"
+);
+const S3rver = req(
+  (process.env.STATARENA_S3_TEST_TOOLS ||
+    "/tmp/statarena-js-worker-s3-20261104") + "/node_modules/s3rver",
+);
+const dir = await mkdtemp(path.join(tmpdir(), "worker-staging-")),
+  s3dir = path.join(dir, "s3");
+await mkdir(s3dir);
+const reserved = Bun.listen({
+    hostname: "127.0.0.1",
+    port: 0,
+    socket: { data() {} },
+  }),
+  port = reserved.port;
+reserved.stop(true);
+const pg = new PG({
+  databaseDir: dir + "/pg",
+  user: "fixture",
+  password: "fixture",
+  port,
+  persistent: false,
+  autoRehydrateSymlinks: true,
+  postgresFlags: ["-c", "listen_addresses=127.0.0.1"],
+  onLog() {},
+  onError() {},
+});
+const s3 = new S3rver({
+  address: "127.0.0.1",
+  port: 0,
+  silent: true,
+  directory: s3dir,
+});
+let admin, store, worker;
+const report = {
+  command:
+    "bun docs/verification/aws-legacy-retirement-20261104/verify.mjs " + stage,
+  phase: stage,
+  tools: {
+    pg: "embedded PostgreSQL 18.6",
+    s3: "S3rver 3.7.1, real local HTTP, disk-backed; not AWS",
+  },
+  checks: [],
+  keys: [],
+};
+const sha = (b) => createHash("sha256").update(b).digest("hex");
+try {
+  await pg.initialise();
+  await pg.start();
+  const dburl =
+    "postgresql://fixture:fixture@127.0.0.1:" +
+    port +
+    "/postgres?sslmode=disable";
+  admin = new Client({ connectionString: dburl });
+  await admin.connect();
+  await admin.query(
+    await readFile(cwd + "/dashboard/backend/migrations/001_neon.sql", "utf8"),
+  );
+  await admin.query(
+    await readFile(
+      cwd + "/dashboard/backend/migrations/002_aws_documents.sql",
+      "utf8",
+    ),
+  );
+  const service = await s3.run(),
+    endpoint = "http://127.0.0.1:" + service.port,
+    bucket = "local-staging";
+  store = new S3Client({
+    region: "us-east-2",
+    endpoint,
+    forcePathStyle: true,
+    credentials: { accessKeyId: "S3RVER", secretAccessKey: "S3RVER" },
+    requestChecksumCalculation: "WHEN_REQUIRED",
+  });
+  await store.send(new CreateBucketCommand({ Bucket: bucket }));
+  async function put(key, body) {
+    await store.send(
+      new PutObjectCommand({ Bucket: bucket, Key: "data/" + key, Body: body }),
+    );
+    report.keys.push("data/" + key);
+  }
+  async function object(
+    key,
+    value,
+    { historical = false, corrupt = false } = {},
+  ) {
+    const b = key.endsWith(".gz")
+        ? gzipSync(JSON.stringify(value))
+        : Buffer.from(JSON.stringify(value)),
+      hash = sha(b);
+    await admin.query(
+      "insert into statarena.objects(path,size,sha256,etag) values($1,$2,decode($3,'hex'),$3)",
+      [key, b.length, hash],
+    );
+    await put(key, corrupt || historical ? Buffer.from("wrong bytes") : b);
+    if (historical)
+      await put(
+        "raw/neon/versions/" +
+          hash +
+          (key.endsWith(".gz") ? ".json.gz" : ".json"),
+        b,
+      );
+  }
+  const manifest = {
+    seasons: [
+      {
+        id: "2026/2027",
+        chunks: [{ leagueId: "l_000001", path: "computed/test.json.gz" }],
+      },
+    ],
+    clubCountries: {},
+  };
+  await object("computed/dashboard/index.json", manifest, { historical: true });
+  await object("computed/test.json.gz", {
+    tables: { teams: { keys: ["id"], rows: [] } },
+  });
+  await object("raw/rankings/club-links.json", {
+    links: { t_123456: { entityId: "uefa:1000" } },
+  });
+  await object("raw/fixtures.json.gz", [
+    { id: "doc-a", endpoints: ["lineups"] },
+  ]);
+  const lineup = {
+    status: 200,
