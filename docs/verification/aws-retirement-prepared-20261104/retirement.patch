@@ -0,0 +1,87 @@
+// No request is forwarded. UEFA, Wikidata and Commons responses are deterministic fixtures.
+globalThis.fetch = async (input) => {
+  const u = new URL(input instanceof Request ? input.url : input);
+  if (
+    u.hostname === "raw.githubusercontent.com" &&
+    u.pathname.includes("/openfootball/euro.json/")
+  )
+    return Response.json({
+      name: "Fixture EURO cup",
+      matches: [
+        {
+          round: "Final",
+          date: "2024-07-14",
+          team1: "A",
+          team2: "B",
+          score: { ft: [1, 0] },
+        },
+      ],
+    });
+  if (u.hostname === "query.wikidata.org")
+    return Response.json({
+      results: {
+        bindings: [
+          {
+            label: { value: "Fixture Coach" },
+            person: { value: "https://www.wikidata.org/entity/Q123" },
+            image: {
+              value:
+                "https://commons.wikimedia.org/wiki/Special:FilePath/Fixture_Coach.jpg",
+            },
+          },
+        ],
+      },
+    });
+  if (u.hostname === "commons.wikimedia.org")
+    return Response.json({
+      query: {
+        pages: {
+          1: {
+            title: "File:Fixture Coach.jpg",
+            imageinfo: [
+              {
+                url: "https://upload.wikimedia.org/wikipedia/commons/0/01/Fixture_Coach.jpg",
+                descriptionurl:
+                  "https://commons.wikimedia.org/wiki/File:Fixture_Coach.jpg",
+                extmetadata: {
+                  Artist: { value: "Fixture Author" },
+                  LicenseShortName: { value: "CC BY 4.0" },
+                },
+              },
+            ],
+          },
+        },
+      },
+    });
+  if (u.hostname !== "standings.uefa.com")
+    return new Response(null, { status: 404 });
+  const year = Number(u.searchParams.get("seasonYear")),
+    competitionId = u.searchParams.get("competitionId"),
+    modern = year >= 2025;
+  const groups = Array.from({ length: modern ? 1 : 8 }, (_, g) => ({
+    group: {
+      competitionId,
+      seasonYear: String(year),
+      phase: "TOURNAMENT",
+      metaData: {
+        groupName: modern
+          ? "League phase"
+          : "Group " + String.fromCharCode(65 + g),
+      },
+    },
+    items: Array.from({ length: modern ? 36 : 4 }, (_, i) => ({
+      rank: i + 1,
+      played: 6,
+      won: 3,
+      drawn: 2,
+      lost: 1,
+      goalsFor: 10,
+      goalsAgainst: 4,
+      goalDifference: 6,
+      points: 11,
+      teamId: String(1000 + g * 4 + i),
+      team: { internationalName: "Club " + i },
+    })),
+  }));
+  return Response.json(groups);
+};
