	);
	
	COMMENT ON TABLE "football"."match_events" IS 'Flux courant d’événements remplacé atomiquement lors d’une correction. Grain: Match × ordinal dans la version courante.';
	
	COMMENT ON COLUMN "football"."match_events"."match_id" IS 'Référence SQL vers football.matches(id); football.match_teams(match_id, team_id).';
	
