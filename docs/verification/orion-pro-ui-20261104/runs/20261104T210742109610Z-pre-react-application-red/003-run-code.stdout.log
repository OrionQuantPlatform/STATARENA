await (async (page) => {
  const proof = page.__orionUI = { requests: [], responses: [], failures: [], console: [], pageErrors: [], external: [] };
  await page.context().route("**/*", async (route) => {
    const url = new URL(route.request().url());
    if (["http:", "https:"].includes(url.protocol) && !["127.0.0.1", "localhost"].includes(url.hostname)) {
      proof.external.push({ url: url.href, method: route.request().method() });
      return route.abort("blockedbyclient");
    }
    return route.continue();
  });
  page.on("request", (request) => proof.requests.push({ url: request.url(), method: request.method(), resourceType: request.resourceType(), at: Date.now() }));
  page.on("requestfailed", (request) => proof.failures.push({ url: request.url(), method: request.method(), reason: request.failure()?.errorText, at: Date.now() }));
  page.on("response", async (response) => {
    const entry = { url: response.url(), method: response.request().method(), status: response.status(), headers: await response.allHeaders(), at: Date.now() };
    proof.responses.push(entry);
    if (new URL(entry.url).pathname.startsWith("/api/")) {
      try { entry.body = await response.text(); } catch (error) { entry.bodyReadError = String(error); }
    }
  });
  page.on("console", (message) => proof.console.push({ type: message.type(), text: message.text(), at: Date.now() }));
  page.on("pageerror", (error) => proof.pageErrors.push({ message: String(error), at: Date.now() }));
  await page.addInitScript(() => {
    localStorage.setItem("orion.preferences.v1", JSON.stringify({ focus: "all", defaultSeason: "2024/2025", favoriteLeagueIds: [], onboardingComplete: true }));
  });
  await page.setViewportSize({ width: 1440, height: 1000 });
  return { instrumentation: "requests/responses/failures/console/pageErrors", externalNetwork: "blocked and recorded; never fulfilled", preferences: { key: "orion.preferences.v1", focus: "all", defaultSeason: "2024/2025", favoriteLeagueIds: [], onboardingComplete: true } };
}
)(page);
