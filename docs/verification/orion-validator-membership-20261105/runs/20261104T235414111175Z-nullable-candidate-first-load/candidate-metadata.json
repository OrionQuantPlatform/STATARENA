  "original_query": "SELECT 1 FROM \"football\".\"player_match_metric_values\" child JOIN \"football\".\"match_players\" anchor ON anchor.\"match_id\" = child.\"match_id\" AND anchor.\"player_id\" = child.\"player_id\" AND anchor.\"team_id\" = child.\"team_id\" AND anchor.\"revision_id\" = child.\"match_player_revision_id\" WHERE ingest.selected_at(g,child.\"recorded_from_gen\",child.\"recorded_to_gen\") AND child.\"is_canonical\" AND NOT child.\"is_deleted\" AND child.\"match_id\" IS NOT NULL AND child.\"player_id\" IS NOT NULL AND child.\"team_id\" IS NOT NULL AND child.\"match_player_revision_id\" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM \"football\".\"match_players\" selected_parent WHERE ingest.selected_at(g,selected_parent.\"recorded_from_gen\",selected_parent.\"recorded_to_gen\") AND selected_parent.\"is_canonical\" AND NOT selected_parent.\"is_deleted\" AND selected_parent.\"match_id\" IS NOT DISTINCT FROM anchor.\"match_id\" AND selected_parent.\"player_id\" IS NOT DISTINCT FROM anchor.\"player_id\" AND selected_parent.\"position_code\" IS NOT DISTINCT FROM anchor.\"position_code\" AND selected_parent.\"team_id\" IS NOT DISTINCT FROM anchor.\"team_id\")",
  "candidate_query": "SELECT 1 FROM \"football\".\"player_match_metric_values\" child JOIN \"football\".\"match_players\" anchor ON anchor.\"match_id\" = child.\"match_id\" AND anchor.\"player_id\" = child.\"player_id\" AND anchor.\"team_id\" = child.\"team_id\" AND anchor.\"revision_id\" = child.\"match_player_revision_id\" WHERE ingest.selected_at(g,child.\"recorded_from_gen\",child.\"recorded_to_gen\") AND child.\"is_canonical\" AND NOT child.\"is_deleted\" AND child.\"match_id\" IS NOT NULL AND child.\"player_id\" IS NOT NULL AND child.\"team_id\" IS NOT NULL AND child.\"match_player_revision_id\" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM \"football\".\"match_players\" selected_parent WHERE ingest.selected_at(g,selected_parent.\"recorded_from_gen\",selected_parent.\"recorded_to_gen\") AND selected_parent.\"is_canonical\" AND NOT selected_parent.\"is_deleted\" AND selected_parent.\"match_id\" = anchor.\"match_id\" AND selected_parent.\"player_id\" = anchor.\"player_id\" AND selected_parent.\"position_code\" IS NOT DISTINCT FROM anchor.\"position_code\" AND selected_parent.\"team_id\" = anchor.\"team_id\")"
