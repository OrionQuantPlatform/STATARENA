```js
await (async (page) => {
const folder = "/Users/lemonnierhugo/Desktop/Coding Project/Football_ranking/output/playwright/page-seasons-layout-20261103/";
const report = {
  setup: "Real archived 2025/2026 Neon season, Europe scope, local Next server, Chromium.",
  command: "python3 output/playwright/page-seasons-layout-20261103/run_cli.py layout",
  expected: "The chart uses its container width with readable labels; no empty grid wrappers, no horizontal overflow, working competition tabs/tooltips, no footer.",
  checks: [],
  status: "failed",
};
const check = (name, passed, actual) => {
  report.checks.push({name, actual, passed});
  if (!passed) throw new Error(name + ": " + JSON.stringify(actual));
};
try {
  await page.goto("http://127.0.0.1:3000/?season=2025%2F2026&focus=europe");
  await page.locator(".home-race-chart").waitFor({timeout: 30000});
  const theme = page.getByRole("button", {name: /Activer le thème/});
  if ((await theme.getAttribute("aria-label"))?.includes("clair")) await theme.click();
  for (const [width, height, label] of [[1920,1080,"wide-light"],[1440,1000,"desktop-light"],[900,1000,"tablet-light"],[390,844,"mobile-light"]]) {
    await page.setViewportSize({width,height});
    await page.waitForFunction(() => {
      const svg = document.querySelector(".home-race-chart");
      return svg && Math.abs(svg.viewBox.baseVal.width - svg.clientWidth) < 2;
    });
    const metrics = await page.evaluate(() => {
      const svg = document.querySelector(".home-race-chart");
      const box = svg.getBoundingClientRect();
      const siblings = [...document.querySelectorAll(".home-bento > div")];
      return {
        width: box.width,
        height: box.height,
        viewBox: svg.getAttribute("viewBox"),
        plotFraction: (svg.viewBox.baseVal.width - 56) * svg.getScreenCTM().a / box.width,
        scale: svg.getScreenCTM().a,
        overflow: document.documentElement.scrollWidth > window.innerWidth,
        emptyWrappers: siblings.filter((el) => !el.children.length).length,
        footer: document.querySelectorAll("footer").length,
      };
    });
    check(label + " chart fills its available width", metrics.scale > 0.99 && metrics.plotFraction > 0.78, metrics);
    check(label + " has no empty wrappers or overflow", !metrics.overflow && metrics.emptyWrappers === 0 && metrics.footer === 0, metrics);
    await page.locator(".home-race").screenshot({path: folder + label + "-race.png"});
    if (width === 390) await page.screenshot({path: folder + "mobile-light-page.png", fullPage: true});
  }
  await theme.click();
  await page.locator(".home-race").screenshot({path: folder + "mobile-dark-race.png"});
  await page.setViewportSize({width:1920,height:1080});
  await page.waitForFunction(() => { const svg = document.querySelector(".home-race-chart"); return Math.abs(svg.viewBox.baseVal.width - svg.clientWidth) < 2; });
  await page.locator(".home-tabs button").filter({hasText: /^Ligue 1$/}).click();
  const svg = page.locator(".home-race-chart");
  const box = await svg.boundingBox();
  await svg.hover({position:{x:box.width * 0.55,y:box.height * 0.5}});
  await page.locator(".home-race .home-tip").waitFor({state:"visible"});
  const tooltip = await page.locator(".home-race .home-tip").innerText();
  check("hover has matchday and team points", /Journée \d+/.test(tooltip) && /pts/.test(tooltip), tooltip);
  await page.locator(".home-race").screenshot({path:folder+"wide-dark-tooltip.png"});
  await page.locator(".home-tabs button").filter({hasText:/^Premier League$/}).click();
  check("competition tab changes", await page.locator(".home-tabs button").filter({hasText:/^Premier League$/}).getAttribute("aria-pressed") === "true", await page.locator(".home-race-chart").getAttribute("aria-label"));
  check("changing competition clears stale tooltip", await page.locator(".home-race .home-tip").count() === 0, await page.locator(".home-race .home-tip").count());
  report.status = "passed";
} catch (error) {
  report.error = error.message;
  await page.screenshot({path:folder+"layout-failure.png",fullPage:true});
}
return report;

})(page);
