  checks: [],
  status: "failed",
};
const check = (name, actual, expected) => {
  report.checks.push({name,actual,expected,passed:actual === expected});
  if (actual !== expected) throw new Error(`${name}: ${actual} instead of ${expected}`);
};
try {
  await page.goto("http://127.0.0.1:3000/");
